          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "scanner_version",
          "description": "The scanner's version.",
          "@type": "SlotDefinition"
        },
        {
          "name": "vuln_db",
          "description": "The vulnerability database the scanner used.",
          "range": "InTotoVulnDatabase",
          "inlined": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "scan_results",
          "description": "The vulnerabilities the scanner found; an empty list means it found none.",
          "range": "InTotoVulnResult",
          "required": true,
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/in-toto/InTotoVulnScanner",
      "@type": "ClassDefinition"
    },
    {
      "name": "InTotoVulnDatabase",
      "definition_uri": "https://w3id.org/lmodel/in-toto/InTotoVulnDatabase",
      "description": "The vulnerability database a scanner used.",
      "from_schema": "https://w3id.org/lmodel/in-toto/in_toto_predicates",
      "see_also": [
