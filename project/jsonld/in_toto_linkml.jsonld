      ],
      "range": "string",
      "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$",
      "@type": "SlotDefinition"
    },
    {
      "name": "inTotoDigestSet__additional_digests",
      "description": "The digests under algorithms this class does not name.",
      "from_schema": "https://w3id.org/lmodel/in-toto/in_toto_core",
      "mappings": [
        "https://w3id.org/lmodel/in-toto/additional_digests"
      ],
      "slot_uri": "https://w3id.org/lmodel/in-toto/additional_digests",
      "alias": "additional_digests",
      "owner": "InTotoDigestSet",
      "domain_of": [
        "InTotoDigestSet"
      ],
      "range": "InTotoAdditionalDigest",
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "minimum_cardinality": 1,
      "@type": "SlotDefinition"
    },
    {
      "name": "inTotoAdditionalDigest__algorithm",
      "description": "The algorithm's name, as the key the attestation's JSON uses, such as svn_revision_id.",
      "comments": [
        "An algorithm that InTotoDigestSet names, by its JSON key or by its field name, goes in that field instead.",
        "A name starts with a lowercase letter, as the framework's own names do, so that SHA256 is not taken for sha256, and it may hold a colon, as go-witness's gitoid:sha256 does. The framework itself sets no rule for other names."
      ],
      "from_schema": "https://w3id.org/lmodel/in-toto/in_toto_core",
      "mappings": [
        "http://spdx.org/rdf/terms#algorithm"
      ],
      "slot_uri": "http://spdx.org/rdf/terms#algorithm",
      "alias": "algorithm",
      "owner": "InTotoAdditionalDigest",
      "domain_of": [
        "InTotoAdditionalDigest"
      ],
      "range": "string",
      "required": true,
      "pattern": "^[a-z][A-Za-z0-9_.:-]*$",
      "none_of": [
        {
          "equals_string_in": [
            "sha256",
            "sha224",
            "sha384",
            "sha512",
            "sha512_224",
            "sha512_256",
            "sha3_224",
            "sha3_256",
            "sha3_384",
            "sha3_512",
            "shake128",
            "shake256",
            "blake2b",
            "blake2s",
            "ripemd160",
            "sm3",
            "gost",
            "sha1",
            "md5",
            "dirHash",
            "gitCommit",
            "gitTree",
            "gitBlob",
            "gitTag",
            "dir_hash",
            "git_commit",
            "git_tree",
            "git_blob",
            "git_tag"
          ],
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "inTotoAdditionalDigest__value",
      "description": "The digest under that algorithm, in the encoding the algorithm documents.",
      "from_schema": "https://w3id.org/lmodel/in-toto/in_toto_core",
      "mappings": [
        "https://w3id.org/lmodel/in-toto/value"
      ],
      "slot_uri": "https://w3id.org/lmodel/in-toto/value",
      "alias": "value",
      "owner": "InTotoAdditionalDigest",
      "domain_of": [
        "InTotoAdditionalDigest"
      ],
      "range": "string",
      "required": true,
      "pattern": "^\\S+$",
      "@type": "SlotDefinition"
    },
    {
      "name": "inTotoAnnotation__annotation_key",
      "description": "The annotation's key.",
      "from_schema": "https://w3id.org/lmodel/in-toto/in_toto_core",
      "mappings": [
        "https://w3id.org/lmodel/in-toto/annotation_key"
      ],
      "slot_uri": "https://w3id.org/lmodel/in-toto/annotation_key",
      "alias": "annotation_key",
      "owner": "InTotoAnnotation",
      "domain_of": [
        "InTotoAnnotation"
      ],
      "range": "string",
      "required": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "inTotoAnnotation__annotation_values",
      "description": "The annotation's values.",
      "from_schema": "https://w3id.org/lmodel/in-toto/in_toto_core",
      "mappings": [
        "https://w3id.org/lmodel/in-toto/annotation_values"
      ],
      "slot_uri": "https://w3id.org/lmodel/in-toto/annotation_values",
      "alias": "annotation_values",
      "owner": "InTotoAnnotation",
      "domain_of": [
        "InTotoAnnotation"
      ],
      "range": "string",
      "multivalued": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "inTotoResourceDescriptor__resource_name",
      "description": "A name for the resource within the attestation that carries it.",
      "from_schema": "https://w3id.org/lmodel/in-toto/in_toto_core",
      "mappings": [
        "https://w3id.org/lmodel/in-toto/resource_name"
      ],
      "slot_uri": "https://w3id.org/lmodel/in-toto/resource_name",
      "alias": "resource_name",
      "owner": "InTotoResourceDescriptor",
      "domain_of": [
        "InTotoResourceDescriptor"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "inTotoResourceDescriptor__download_location",
      "description": "Where the resource can be fetched, when that differs from its identifying URI.",
      "from_schema": "https://w3id.org/lmodel/in-toto/in_toto_core",
      "mappings": [
        "https://w3id.org/lmodel/in-toto/download_location"
      ],
      "slot_uri": "https://w3id.org/lmodel/in-toto/download_location",
      "alias": "download_location",
      "owner": "InTotoResourceDescriptor",
      "domain_of": [
        "InTotoResourceDescriptor"
      ],
      "range": "uri",
      "@type": "SlotDefinition"
    },
    {
      "name": "inTotoResourceDescriptor__media_type",
      "description": "The IANA media type of the resource's content.",
      "from_schema": "https://w3id.org/lmodel/in-toto/in_toto_core",
      "mappings": [
        "http://www.w3.org/ns/dcat#mediaType"
      ],
      "slot_uri": "http://www.w3.org/ns/dcat#mediaType",
      "alias": "media_type",
      "owner": "InTotoResourceDescriptor",
      "domain_of": [
        "InTotoResourceDescriptor"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "inTotoResourceDescriptor__content",
      "description": "The resource's content itself, base64-encoded, for a resource small enough to carry inline.",
      "comments": [
        "The in-toto framework asks for content under 1 KB, so that attestations stay small."
      ],
      "from_schema": "https://w3id.org/lmodel/in-toto/in_toto_core",
      "mappings": [
        "https://w3id.org/lmodel/in-toto/content"
      ],
      "slot_uri": "https://w3id.org/lmodel/in-toto/content",
      "alias": "content",
      "owner": "InTotoResourceDescriptor",
      "domain_of": [
        "InTotoResourceDescriptor"
      ],
      "range": "string",
      "pattern": "^[A-Za-z0-9+/_-]+={0,2}$",
      "@type": "SlotDefinition"
    },
    {
      "name": "inTotoResourceDescriptor__annotations",
      "description": "Vendor-specific annotations on the resource, such as the source references a SLSA Source Verification Summary records.",
      "from_schema": "https://w3id.org/lmodel/in-toto/in_toto_core",
      "mappings": [
        "https://w3id.org/lmodel/in-toto/annotations"
      ],
      "slot_uri": "https://w3id.org/lmodel/in-toto/annotations",
      "alias": "annotations",
      "owner": "InTotoResourceDescriptor",
      "domain_of": [
        "InTotoResourceDescriptor"
      ],
      "range": "InTotoAnnotation",
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "inTotoStatement__statement_type",
      "description": "The in-toto statement type, always https://in-toto.io/Statement/v1.",
      "from_schema": "https://w3id.org/lmodel/in-toto/in_toto_core",
      "mappings": [
        "https://w3id.org/lmodel/in-toto/statement_type"
      ],
      "slot_uri": "https://w3id.org/lmodel/in-toto/statement_type",
      "alias": "statement_type",
      "owner": "InTotoStatement",
      "domain_of": [
        "InTotoStatement"
      ],
      "range": "uri",
      "required": true,
      "pattern": "^https://in-toto\\.io/Statement/v1$",
      "@type": "SlotDefinition"
    },
    {
      "name": "inTotoStatement__subject",
      "description": "The artifacts the predicate is about, each with a digest.",
      "from_schema": "https://w3id.org/lmodel/in-toto/in_toto_core",
      "mappings": [
        "https://w3id.org/lmodel/in-toto/subject"
      ],
      "slot_uri": "https://w3id.org/lmodel/in-toto/subject",
