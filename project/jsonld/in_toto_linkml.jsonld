      "name": "InTotoVulnResult",
      "definition_uri": "https://w3id.org/lmodel/in-toto/InTotoVulnResult",
      "description": "One vulnerability a scanner found.",
      "from_schema": "https://w3id.org/lmodel/in-toto/in_toto_predicates",
