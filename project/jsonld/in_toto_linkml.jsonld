{
  "name": "in_toto_linkml",
  "annotations": [
    {
      "tag": "attestation_tag",
      "value": "v1.2.0"
    },
    {
      "tag": "attestation_commit",
      "value": "df02077bf97218a8860a5c534eff1f1381f56984"
    }
  ],
  "description": "A LinkML model of the in-toto Attestation Framework: the statement that binds an attestation to its subjects, the resource descriptor and digest set that identify an artifact, the predicate types the in-toto project has vetted, and the vetted predicates that no other lmodel schema models.",
  "title": "in-toto Attestation Framework",
  "comments": [
    "The version is the release of in-toto/attestation the model renders, and the specification pages and protocol buffer definitions of that release are copied to src/in_toto_linkml/schema/attestation/ at the tag and commit in the annotations. The release tags are the schema's own versions, and scripts/check_upstream_release.py reads the same pins and reports when the in-toto project releases again or the copy drifts.",
    "in_toto_core imports only the LinkML types, in_toto_predicates imports the core, and this file adds only the document root, so an importer can take one module. lmodel/slsa imports the core and models SLSA's own predicates."
  ],
  "source": "https://github.com/in-toto/attestation/tree/v1.2.0",
  "see_also": [
    "https://lmodel.github.io/in-toto",
    "https://github.com/in-toto/attestation/blob/v1.2.0/spec/README.md",
    "https://in-toto.io/"
  ],
  "id": "https://w3id.org/lmodel/in-toto",
  "version": "1.2.0",
  "imports": [
    "linkml:types",
    "./in_toto_core",
    "./in_toto_predicates"
  ],
  "license": "Apache-2.0",
  "prefixes": [
    {
      "prefix_prefix": "linkml",
      "prefix_reference": "https://w3id.org/linkml/"
    },
    {
      "prefix_prefix": "in_toto_linkml",
      "prefix_reference": "https://w3id.org/lmodel/in-toto/"
    }
  ],
  "default_prefix": "in_toto_linkml",
  "default_range": "string",
  "types": [
    {
      "name": "string",
      "definition_uri": "https://w3id.org/linkml/String",
      "description": "A character string",
      "notes": [
        "In RDF serializations, a slot with range of string is treated as a literal or type xsd:string. If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"string\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "exact_mappings": [
        "schema:Text"
      ],
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "@type": "TypeDefinition"
    },
    {
      "name": "integer",
      "definition_uri": "https://w3id.org/linkml/Integer",
      "description": "An integer",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"integer\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "exact_mappings": [
        "schema:Integer"
      ],
      "base": "int",
      "uri": "http://www.w3.org/2001/XMLSchema#integer",
      "@type": "TypeDefinition"
    },
    {
      "name": "boolean",
      "definition_uri": "https://w3id.org/linkml/Boolean",
      "description": "A binary (true or false) value",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"boolean\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "exact_mappings": [
        "schema:Boolean"
      ],
      "base": "Bool",
      "uri": "http://www.w3.org/2001/XMLSchema#boolean",
      "repr": "bool",
      "@type": "TypeDefinition"
    },
    {
      "name": "float",
      "definition_uri": "https://w3id.org/linkml/Float",
      "description": "A real number that conforms to the xsd:float specification",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"float\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "exact_mappings": [
        "schema:Float"
      ],
      "base": "float",
      "uri": "http://www.w3.org/2001/XMLSchema#float",
      "@type": "TypeDefinition"
    },
    {
      "name": "double",
      "definition_uri": "https://w3id.org/linkml/Double",
      "description": "A real number that conforms to the xsd:double specification",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"double\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "close_mappings": [
        "schema:Float"
      ],
      "base": "float",
      "uri": "http://www.w3.org/2001/XMLSchema#double",
      "@type": "TypeDefinition"
    },
    {
      "name": "decimal",
      "definition_uri": "https://w3id.org/linkml/Decimal",
      "description": "A real number with arbitrary precision that conforms to the xsd:decimal specification",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"decimal\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "broad_mappings": [
        "schema:Number"
      ],
      "base": "Decimal",
      "uri": "http://www.w3.org/2001/XMLSchema#decimal",
      "@type": "TypeDefinition"
    },
    {
      "name": "time",
      "definition_uri": "https://w3id.org/linkml/Time",
      "description": "A time object represents a (local) time of day, independent of any particular day",
      "notes": [
        "URI is dateTime because OWL reasoners do not work with straight date or time",
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"time\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "exact_mappings": [
        "schema:Time"
      ],
      "base": "XSDTime",
      "uri": "http://www.w3.org/2001/XMLSchema#time",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "date",
      "definition_uri": "https://w3id.org/linkml/Date",
      "description": "a date (year, month and day) in an idealized calendar",
      "notes": [
        "URI is dateTime because OWL reasoners don't work with straight date or time",
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"date\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "exact_mappings": [
        "schema:Date"
      ],
      "base": "XSDDate",
      "uri": "http://www.w3.org/2001/XMLSchema#date",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "datetime",
      "definition_uri": "https://w3id.org/linkml/Datetime",
      "description": "The combination of a date and time",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"datetime\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "exact_mappings": [
        "schema:DateTime"
      ],
      "base": "XSDDateTime",
      "uri": "http://www.w3.org/2001/XMLSchema#dateTime",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "date_or_datetime",
      "definition_uri": "https://w3id.org/linkml/DateOrDatetime",
      "description": "Either a date or a datetime",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"date_or_datetime\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "str",
      "uri": "https://w3id.org/linkml/DateOrDatetime",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "uriorcurie",
      "definition_uri": "https://w3id.org/linkml/Uriorcurie",
      "description": "a URI or a CURIE",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"uriorcurie\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "URIorCURIE",
      "uri": "http://www.w3.org/2001/XMLSchema#anyURI",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "curie",
      "definition_uri": "https://w3id.org/linkml/Curie",
      "conforms_to": "https://www.w3.org/TR/curie/",
      "description": "a compact URI",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"curie\"."
      ],
      "comments": [
        "in RDF serializations this MUST be expanded to a URI",
        "in non-RDF serializations MAY be serialized as the compact representation"
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "Curie",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "uri",
      "definition_uri": "https://w3id.org/linkml/Uri",
      "conforms_to": "https://www.ietf.org/rfc/rfc3987.txt",
      "description": "a complete URI",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"uri\"."
      ],
      "comments": [
        "in RDF serializations a slot with range of uri is treated as a literal or type xsd:anyURI unless it is an identifier or a reference to an identifier, in which case it is translated directly to a node"
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "close_mappings": [
        "schema:URL"
      ],
      "base": "URI",
      "uri": "http://www.w3.org/2001/XMLSchema#anyURI",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "ncname",
      "definition_uri": "https://w3id.org/linkml/Ncname",
      "description": "Prefix part of CURIE",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"ncname\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "NCName",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "objectidentifier",
      "definition_uri": "https://w3id.org/linkml/Objectidentifier",
      "description": "A URI or CURIE that represents an object in the model.",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"objectidentifier\"."
      ],
      "comments": [
        "Used for inheritance and type checking"
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "ElementIdentifier",
      "uri": "http://www.w3.org/ns/shex#iri",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "nodeidentifier",
      "definition_uri": "https://w3id.org/linkml/Nodeidentifier",
      "description": "A URI, CURIE or BNODE that represents a node in a model.",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"nodeidentifier\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "NodeIdentifier",
      "uri": "http://www.w3.org/ns/shex#nonLiteral",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "jsonpointer",
      "definition_uri": "https://w3id.org/linkml/Jsonpointer",
      "conforms_to": "https://datatracker.ietf.org/doc/html/rfc6901",
      "description": "A string encoding a JSON Pointer. The value of the string MUST conform to JSON Point syntax and SHOULD dereference to a valid object within the current instance document when encoded in tree form.",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"jsonpointer\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "jsonpath",
      "definition_uri": "https://w3id.org/linkml/Jsonpath",
      "conforms_to": "https://www.ietf.org/archive/id/draft-goessner-dispatch-jsonpath-00.html",
      "description": "A string encoding a JSON Path. The value of the string MUST conform to JSON Point syntax and SHOULD dereference to zero or more valid objects within the current instance document when encoded in tree form.",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"jsonpath\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "sparqlpath",
      "definition_uri": "https://w3id.org/linkml/Sparqlpath",
      "conforms_to": "https://www.w3.org/TR/sparql11-query/#propertypaths",
      "description": "A string encoding a SPARQL Property Path. The value of the string MUST conform to SPARQL syntax and SHOULD dereference to zero or more valid objects within the current instance document when encoded as RDF.",
      "notes": [
        "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"sparqlpath\"."
      ],
      "from_schema": "https://w3id.org/linkml/types",
      "imported_from": "linkml:types",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#string",
      "repr": "str",
      "@type": "TypeDefinition"
    },
    {
      "name": "InTotoTimestamp",
      "definition_uri": "https://w3id.org/lmodel/in-toto/InTotoTimestamp",
      "description": "A point in time in RFC 3339 format in the UTC time zone, written with a trailing Z, such as 1985-04-12T23:20:50.52Z.",
      "comments": [
        "It extends string rather than datetime, because the LinkML Python runtime writes a datetime's Z as +00:00, which the framework does not allow."
      ],
      "from_schema": "https://w3id.org/lmodel/in-toto/in_toto_predicates",
      "see_also": [
        "https://github.com/in-toto/attestation/blob/v1.2.0/spec/v1/field_types.md#timestamp"
      ],
      "typeof": "string",
      "base": "str",
      "uri": "http://www.w3.org/2001/XMLSchema#dateTime",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
      "@type": "TypeDefinition"
    }
  ],
  "enums": [
    {
      "name": "InTotoTestResultValue",
      "definition_uri": "https://w3id.org/lmodel/in-toto/InTotoTestResultValue",
      "description": "The result of a test run, as a Test Result predicate records it.",
      "from_schema": "https://w3id.org/lmodel/in-toto/in_toto_predicates",
      "see_also": [
        "https://github.com/in-toto/attestation/blob/v1.2.0/spec/predicates/test-result.md"
      ],
      "permissible_values": [
        {
          "text": "PASSED",
          "description": "The run passed."
        },
        {
          "text": "WARNED",
          "description": "The run passed with warnings."
        },
        {
          "text": "FAILED",
          "description": "The run failed."
        }
      ]
    },
    {
      "name": "InTotoVettedPredicate",
      "definition_uri": "https://w3id.org/lmodel/in-toto/InTotoVettedPredicate",
      "description": "The thirteen predicate types the in-toto project lists as vetted at release v1.2.0, each with the predicate_type a statement of it carries at the version its page describes.",
      "comments": [
        "The in-toto project's own types are CURIEs under in_toto. The others are full addresses, because the Python generator writes no namespace for a prefix that only an enum's meaning uses."
      ],
      "from_schema": "https://w3id.org/lmodel/in-toto/in_toto_predicates",
      "see_also": [
        "https://github.com/in-toto/attestation/blob/v1.2.0/spec/predicates/README.md"
      ],
      "permissible_values": [
        {
          "text": "CYCLONEDX",
          "description": "A CycloneDX bill of materials for software artifacts.",
          "meaning": "https://cyclonedx.org/bom/v1.4",
          "see_also": [
            "https://cyclonedx.org/"
          ]
        },
        {
          "text": "LINK",
          "description": "One step of an in-toto layout, for migration from in-toto 0.9.",
          "meaning": "in_toto:link/v0.3"
        },
        {
          "text": "REFERENCE",
          "description": "References to documents relevant to a resource.",
          "meaning": "in_toto:reference/v0.1"
        },
        {
          "text": "RELEASE",
          "description": "An artifact that is part of a given release version.",
          "meaning": "in_toto:release/v0.1"
        },
        {
          "text": "RUNTIME_TRACE",
          "description": "Runtime traces of software supply chain operations.",
          "meaning": "in_toto:runtime-trace/v0.1"
        },
        {
          "text": "SCAI",
          "description": "Evidence-based assertions about software artifact and supply chain attributes or behaviour.",
          "meaning": "in_toto:scai/v0.3"
        },
        {
          "text": "SLSA_PROVENANCE",
          "description": "How an artifact or set of artifacts was produced; lmodel/slsa models it.",
          "meaning": "https://slsa.dev/provenance/v1"
        },
        {
          "text": "SLSA_VERIFICATION_SUMMARY",
          "description": "A SLSA verification decision about a software artifact; lmodel/slsa models it.",
          "meaning": "https://slsa.dev/verification_summary/v1"
        },
        {
          "text": "SPDX2",
          "description": "An SPDX 2 bill of materials for software artifacts.",
          "meaning": "https://spdx.dev/Document/v2.3"
        },
        {
          "text": "SPDX3",
          "description": "An SPDX 3 bill of materials for software artifacts.",
          "meaning": "https://spdx.dev/Document/v3"
        },
        {
          "text": "SIMPLE_VERIFICATION_RESULT",
          "description": "Evidence that an artifact was evaluated against one or more policies.",
          "meaning": "in_toto:svr/v0.1"
        },
        {
          "text": "TEST_RESULT",
          "description": "The results of any type of test.",
          "meaning": "in_toto:test-result/v0.1"
        },
        {
          "text": "VULNS",
          "description": "The results of a vulnerability scan of software artifacts.",
          "meaning": "in_toto:vulns/v0.2"
        }
      ]
    }
  ],
  "slots": [
    {
      "name": "resource_uri",
      "definition_uri": "https://w3id.org/lmodel/in-toto/resource_uri",
      "description": "The URI that identifies a resource, such as a package URL, a git repository address or an OCI image reference.",
      "from_schema": "https://w3id.org/lmodel/in-toto/in_toto_core",
      "see_also": [
        "https://github.com/in-toto/attestation/blob/v1.2.0/spec/v1/field_types.md#resourceuri"
      ],
      "mappings": [
        "https://w3id.org/lmodel/in-toto/resource_uri"
      ],
      "slot_uri": "https://w3id.org/lmodel/in-toto/resource_uri",
      "owner": "InTotoResourceDescriptor",
      "domain_of": [
        "InTotoResourceDescriptor"
      ],
      "range": "uri",
      "@type": "SlotDefinition"
    },
    {
      "name": "digest",
      "definition_uri": "https://w3id.org/lmodel/in-toto/digest",
      "description": "The cryptographic digests of a resource's content, keyed by algorithm.",
      "from_schema": "https://w3id.org/lmodel/in-toto/in_toto_core",
      "see_also": [
        "https://github.com/in-toto/attestation/blob/v1.2.0/spec/v1/digest_set.md"
      ],
      "mappings": [
        "https://w3id.org/lmodel/in-toto/digest"
      ],
      "slot_uri": "https://w3id.org/lmodel/in-toto/digest",
      "owner": "InTotoResourceDescriptor",
      "domain_of": [
        "InTotoResourceDescriptor"
      ],
      "range": "InTotoDigestSet",
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "inTotoDocument__in_toto_statements",
      "description": "The statements, each an in-toto attestation without its envelope.",
      "from_schema": "https://w3id.org/lmodel/in-toto",
      "slot_uri": "https://w3id.org/lmodel/in-toto/in_toto_statements",
      "alias": "in_toto_statements",
      "owner": "InTotoDocument",
      "domain_of": [
        "InTotoDocument"
      ],
      "range": "InTotoStatement",
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "inTotoDocument__in_toto_predicate_types",
      "description": "The predicate types.",
      "from_schema": "https://w3id.org/lmodel/in-toto",
      "slot_uri": "https://w3id.org/lmodel/in-toto/in_toto_predicate_types",
      "alias": "in_toto_predicate_types",
      "owner": "InTotoDocument",
      "domain_of": [
        "InTotoDocument"
      ],
      "range": "InTotoPredicateType",
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "inTotoDigestSet__sha256",
      "description": "The SHA-256 digest of the artifact.",
      "from_schema": "https://w3id.org/lmodel/in-toto/in_toto_core",
      "mappings": [
        "https://w3id.org/lmodel/in-toto/sha256"
      ],
      "slot_uri": "https://w3id.org/lmodel/in-toto/sha256",
      "alias": "sha256",
      "owner": "InTotoDigestSet",
      "domain_of": [
        "InTotoDigestSet"
      ],
      "range": "string",
      "pattern": "^[a-f0-9]{64}$",
      "@type": "SlotDefinition"
    },
    {
      "name": "inTotoDigestSet__sha224",
      "description": "The SHA-224 digest of the artifact.",
      "from_schema": "https://w3id.org/lmodel/in-toto/in_toto_core",
      "mappings": [
        "https://w3id.org/lmodel/in-toto/sha224"
      ],
      "slot_uri": "https://w3id.org/lmodel/in-toto/sha224",
      "alias": "sha224",
      "owner": "InTotoDigestSet",
      "domain_of": [
        "InTotoDigestSet"
      ],
      "range": "string",
      "pattern": "^[a-f0-9]{56}$",
      "@type": "SlotDefinition"
    },
    {
      "name": "inTotoDigestSet__sha384",
      "description": "The SHA-384 digest of the artifact.",
      "from_schema": "https://w3id.org/lmodel/in-toto/in_toto_core",
      "mappings": [
        "https://w3id.org/lmodel/in-toto/sha384"
      ],
