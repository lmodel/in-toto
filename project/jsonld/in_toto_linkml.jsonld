      ],
      "slot_uri": "https://w3id.org/lmodel/in-toto/sha1",
      "alias": "sha1",
      "owner": "InTotoDigestSet",
      "domain_of": [
        "InTotoDigestSet"
      ],
      "range": "string",
      "pattern": "^[a-f0-9]{40}$",
      "@type": "SlotDefinition"
    },
    {
      "name": "inTotoDigestSet__md5",
      "description": "The MD5 digest of the artifact.",
