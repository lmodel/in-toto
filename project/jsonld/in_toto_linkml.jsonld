    },
    {
      "name": "inTotoDigestSet__gost",
      "description": "The GOST R 34.11 digest of the artifact, of 256 or 512 bits.",
      "from_schema": "https://w3id.org/lmodel/in-toto/in_toto_core",
      "mappings": [
        "https://w3id.org/lmodel/in-toto/gost"
      ],
