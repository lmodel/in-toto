      "@type": "ClassDefinition"
    },
    {
      "name": "InTotoDigestSet",
      "definition_uri": "https://w3id.org/lmodel/in-toto/InTotoDigestSet",
      "description": "A set of one or more digests over one artifact, keyed by algorithm, from which a consumer picks the algorithm it trusts.",
      "notes": [
        "Each condition in any_of names its range through a nested any_of, because the JSON Schema generator leaves a condition's own range out, and a null value would then count as present."
      ],
      "comments": [
        "The named algorithms take lowercase hexadecimal, and additional_digests holds any other algorithm, such as an SCS's own revision type.",
        "A consumer accepts only the algorithms it considers secure and ignores the rest, and two sets match when any accepted algorithm matches.",
        "SHAKE and BLAKE2 digests can be of any length, and this schema asks for at least 32 bytes, since a shorter digest resists collisions too weakly to identify an artifact."
      ],
      "from_schema": "https://w3id.org/lmodel/in-toto/in_toto_core",
      "see_also": [
        "https://github.com/in-toto/attestation/blob/v1.2.0/spec/v1/digest_set.md"
      ],
      "slots": [
        "inTotoDigestSet__sha256",
        "inTotoDigestSet__sha224",
        "inTotoDigestSet__sha384",
        "inTotoDigestSet__sha512",
        "inTotoDigestSet__sha512_224",
        "inTotoDigestSet__sha512_256",
        "inTotoDigestSet__sha3_224",
        "inTotoDigestSet__sha3_256",
        "inTotoDigestSet__sha3_384",
        "inTotoDigestSet__sha3_512",
        "inTotoDigestSet__shake128",
        "inTotoDigestSet__shake256",
        "inTotoDigestSet__blake2b",
        "inTotoDigestSet__blake2s",
        "inTotoDigestSet__ripemd160",
        "inTotoDigestSet__sm3",
        "inTotoDigestSet__gost",
        "inTotoDigestSet__sha1",
        "inTotoDigestSet__md5",
        "inTotoDigestSet__dir_hash",
        "inTotoDigestSet__git_commit",
        "inTotoDigestSet__git_tree",
        "inTotoDigestSet__git_blob",
        "inTotoDigestSet__git_tag",
        "inTotoDigestSet__additional_digests"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "sha256",
          "description": "The SHA-256 digest of the artifact.",
          "slot_uri": "in_toto_linkml:sha256",
          "pattern": "^[a-f0-9]{64}$",
          "@type": "SlotDefinition"
        },
        {
          "name": "sha224",
          "description": "The SHA-224 digest of the artifact.",
          "slot_uri": "in_toto_linkml:sha224",
          "pattern": "^[a-f0-9]{56}$",
          "@type": "SlotDefinition"
        },
        {
          "name": "sha384",
          "description": "The SHA-384 digest of the artifact.",
          "slot_uri": "in_toto_linkml:sha384",
          "pattern": "^[a-f0-9]{96}$",
          "@type": "SlotDefinition"
        },
        {
          "name": "sha512",
          "description": "The SHA-512 digest of the artifact.",
          "slot_uri": "in_toto_linkml:sha512",
          "pattern": "^[a-f0-9]{128}$",
          "@type": "SlotDefinition"
        },
        {
          "name": "sha512_224",
          "description": "The SHA-512/224 digest of the artifact.",
          "slot_uri": "in_toto_linkml:sha512_224",
          "pattern": "^[a-f0-9]{56}$",
          "@type": "SlotDefinition"
        },
        {
          "name": "sha512_256",
          "description": "The SHA-512/256 digest of the artifact.",
          "slot_uri": "in_toto_linkml:sha512_256",
          "pattern": "^[a-f0-9]{64}$",
          "@type": "SlotDefinition"
        },
        {
          "name": "sha3_224",
          "description": "The SHA3-224 digest of the artifact.",
          "slot_uri": "in_toto_linkml:sha3_224",
          "pattern": "^[a-f0-9]{56}$",
          "@type": "SlotDefinition"
        },
        {
          "name": "sha3_256",
          "description": "The SHA3-256 digest of the artifact.",
          "slot_uri": "in_toto_linkml:sha3_256",
          "pattern": "^[a-f0-9]{64}$",
          "@type": "SlotDefinition"
        },
        {
          "name": "sha3_384",
          "description": "The SHA3-384 digest of the artifact.",
          "slot_uri": "in_toto_linkml:sha3_384",
          "pattern": "^[a-f0-9]{96}$",
          "@type": "SlotDefinition"
        },
        {
          "name": "sha3_512",
          "description": "The SHA3-512 digest of the artifact.",
          "slot_uri": "in_toto_linkml:sha3_512",
          "pattern": "^[a-f0-9]{128}$",
          "@type": "SlotDefinition"
        },
        {
          "name": "shake128",
          "description": "The SHAKE128 digest of the artifact, of at least 32 bytes.",
          "slot_uri": "in_toto_linkml:shake128",
          "pattern": "^[a-f0-9]{64}([a-f0-9]{2})*$",
          "@type": "SlotDefinition"
        },
        {
          "name": "shake256",
          "description": "The SHAKE256 digest of the artifact, of at least 32 bytes.",
          "slot_uri": "in_toto_linkml:shake256",
          "pattern": "^[a-f0-9]{64}([a-f0-9]{2})*$",
          "@type": "SlotDefinition"
        },
        {
          "name": "blake2b",
          "description": "The BLAKE2b digest of the artifact, of 32 to 64 bytes.",
          "slot_uri": "in_toto_linkml:blake2b",
          "pattern": "^[a-f0-9]{64}([a-f0-9]{2}){0,32}$",
          "@type": "SlotDefinition"
        },
        {
          "name": "blake2s",
          "description": "The BLAKE2s digest of the artifact, at its full 32 bytes.",
          "slot_uri": "in_toto_linkml:blake2s",
          "pattern": "^[a-f0-9]{64}$",
          "@type": "SlotDefinition"
        },
        {
          "name": "ripemd160",
          "description": "The RIPEMD-160 digest of the artifact.",
          "slot_uri": "in_toto_linkml:ripemd160",
          "pattern": "^[a-f0-9]{40}$",
          "@type": "SlotDefinition"
        },
        {
          "name": "sm3",
          "description": "The SM3 digest of the artifact.",
          "slot_uri": "in_toto_linkml:sm3",
          "pattern": "^[a-f0-9]{64}$",
          "@type": "SlotDefinition"
        },
        {
          "name": "gost",
          "description": "The GOST R 34.11 digest of the artifact, of 256 or 512 bits.",
          "slot_uri": "in_toto_linkml:gost",
          "pattern": "^[a-f0-9]{64}([a-f0-9]{64})?$",
          "@type": "SlotDefinition"
        },
        {
          "name": "sha1",
          "description": "The SHA-1 digest of the artifact.",
          "comments": [
            "SHA-1 lacks collision resistance, so most consumers should not rely on it."
          ],
          "slot_uri": "in_toto_linkml:sha1",
          "pattern": "^[a-f0-9]{40}$",
          "@type": "SlotDefinition"
        },
        {
          "name": "md5",
          "description": "The MD5 digest of the artifact.",
          "comments": [
            "MD5 lacks collision resistance, so most consumers should not accept it."
          ],
          "slot_uri": "in_toto_linkml:md5",
          "pattern": "^[a-f0-9]{32}$",
          "@type": "SlotDefinition"
        },
        {
          "name": "dir_hash",
          "description": "A digest over a directory's content by the dirhash Hash1 function, in lowercase hexadecimal rather than base64.",
          "slot_uri": "in_toto_linkml:dir_hash",
          "pattern": "^[a-f0-9]{64}$",
          "@type": "SlotDefinition"
        },
        {
          "name": "git_commit",
