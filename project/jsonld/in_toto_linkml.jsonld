        {
          "name": "build_finished_on",
          "description": "When the monitored build finished.",
          "range": "InTotoTimestamp",
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/in-toto/InTotoTraceMetadata",
      "@type": "ClassDefinition"
    },
    {
      "name": "InTotoVulns",
      "definition_uri": "https://w3id.org/lmodel/in-toto/InTotoVulns",
      "description": "The predicate that records the result of one vulnerability scan of the subjects: the scanner, its database and the vulnerabilities it found.",
      "comments": [
        "The statement that carries it has predicate_type https://in-toto.io/attestation/vulns/v0.2."
      ],
      "from_schema": "https://w3id.org/lmodel/in-toto/in_toto_predicates",
      "see_also": [
        "https://github.com/in-toto/attestation/blob/v1.2.0/spec/predicates/vulns_02.md"
      ],
      "exact_mappings": [
        "in_toto:vulns/v0.2"
      ],
      "is_a": "InTotoPredicate",
      "slots": [
        "inTotoPredicate__predicate_kind",
        "inTotoVulns__vuln_scanner",
        "inTotoVulns__scan_metadata"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "vuln_scanner",
          "description": "The scanner that ran, its version and the database it used.",
          "range": "InTotoVulnScanner",
          "required": true,
          "inlined": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "scan_metadata",
          "description": "When the scan ran.",
          "range": "InTotoScanMetadata",
          "required": true,
          "inlined": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/in-toto/InTotoVulns",
      "@type": "ClassDefinition"
    },
    {
      "name": "InTotoVulnScanner",
      "definition_uri": "https://w3id.org/lmodel/in-toto/InTotoVulnScanner",
      "description": "The scanner a VULNS predicate records, with its results.",
      "from_schema": "https://w3id.org/lmodel/in-toto/in_toto_predicates",
      "see_also": [
        "https://github.com/in-toto/attestation/blob/v1.2.0/spec/predicates/vulns_02.md"
      ],
      "slots": [
