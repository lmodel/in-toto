      "name": "InTotoDocument",
      "definition_uri": "https://w3id.org/lmodel/in-toto/InTotoDocument",
      "description": "A document that holds in-toto statements and the predicate types they name.",
      "from_schema": "https://w3id.org/lmodel/in-toto",
      "slots": [
        "inTotoDocument__in_toto_statements",
        "inTotoDocument__in_toto_predicate_types"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "in_toto_statements",
          "description": "The statements, each an in-toto attestation without its envelope.",
