          "range": "uri",
          "@type": "SlotDefinition"
        },
        {
          "name": "db_version",
          "description": "The database's version.",
          "@type": "SlotDefinition"
        },
        {
          "name": "db_last_update",
          "description": "When the database was last updated.",
          "range": "InTotoTimestamp",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/in-toto/InTotoVulnDatabase",
