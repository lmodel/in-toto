        "inTotoVulnScanner__scanner_version",
        "inTotoVulnScanner__vuln_db",
        "inTotoVulnScanner__scan_results"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "scanner_uri",
          "description": "The URI that identifies the scanner's source.",
