      "owner": "InTotoDigestSet",
      "domain_of": [
        "InTotoDigestSet"
      ],
      "range": "string",
      "pattern": "^[a-f0-9]{64}([a-f0-9]{64})?$",
      "@type": "SlotDefinition"
    },
    {
      "name": "inTotoDigestSet__sha1",
      "description": "The SHA-1 digest of the artifact.",
      "comments": [
        "SHA-1 lacks collision resistance, so most consumers should not rely on it."
