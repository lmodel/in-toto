in_toto_linkml:InTotoTestResultValue\#FAILED a owl:Class ;
	rdfs:label "FAILED" ;
	rdfs:subClassOf in_toto_linkml:InTotoTestResultValue ;
	skos:definition "The run failed." .
in_toto_linkml:InTotoTestResultValue\#PASSED a owl:Class ;
