	rdfs:subClassOf _:c14n141 , _:c14n249 , _:c14n326 , _:c14n35 , _:c14n57 , _:c14n98 ;
	skos:definition "One severity score of a vulnerability, by one scoring method." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:InTotoVulns a owl:Class ;
	rdfs:label "InTotoVulns" ;
	rdfs:seeAlso <https://github.com/in-toto/attestation/blob/v1.2.0/spec/predicates/vulns_02.md> ;
	rdfs:subClassOf in_toto_linkml:InTotoPredicate , _:c14n196 , _:c14n219 , _:c14n360 , _:c14n369 , _:c14n50 , _:c14n90 ;
