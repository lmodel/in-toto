@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix in_toto_linkml: <https://w3id.org/lmodel/in-toto/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix pav: <http://purl.org/pav/> .
xsd:dateTime a rdfs:Datatype ;
	owl:equivalentClass _:c14n372 .
<https://cyclonedx.org/bom/v1.4> a owl:Class ;
	rdfs:label "CYCLONEDX" ;
	rdfs:seeAlso <https://cyclonedx.org/> ;
	rdfs:subClassOf in_toto_linkml:InTotoVettedPredicate ;
	skos:definition "A CycloneDX bill of materials for software artifacts." .
<https://in-toto.io/attestation/link/v0.3> a owl:Class ;
	rdfs:label "LINK" ;
	rdfs:subClassOf in_toto_linkml:InTotoVettedPredicate ;
	skos:definition "One step of an in-toto layout, for migration from in-toto 0.9." .
<https://in-toto.io/attestation/reference/v0.1> a owl:Class ;
	rdfs:label "REFERENCE" ;
	rdfs:subClassOf in_toto_linkml:InTotoVettedPredicate ;
	skos:definition "References to documents relevant to a resource." .
<https://in-toto.io/attestation/release/v0.1> a owl:Class ;
	rdfs:label "RELEASE" ;
	rdfs:subClassOf in_toto_linkml:InTotoVettedPredicate ;
	skos:definition "An artifact that is part of a given release version." .
<https://in-toto.io/attestation/runtime-trace/v0.1> a owl:Class ;
	rdfs:label "RUNTIME_TRACE" ;
	rdfs:subClassOf in_toto_linkml:InTotoVettedPredicate ;
	skos:definition "Runtime traces of software supply chain operations." .
<https://in-toto.io/attestation/scai/v0.3> a owl:Class ;
	rdfs:label "SCAI" ;
	rdfs:subClassOf in_toto_linkml:InTotoVettedPredicate ;
	skos:definition "Evidence-based assertions about software artifact and supply chain attributes or behaviour." .
<https://in-toto.io/attestation/svr/v0.1> a owl:Class ;
	rdfs:label "SIMPLE_VERIFICATION_RESULT" ;
	rdfs:subClassOf in_toto_linkml:InTotoVettedPredicate ;
	skos:definition "Evidence that an artifact was evaluated against one or more policies." .
<https://in-toto.io/attestation/test-result/v0.1> a owl:Class ;
	rdfs:label "TEST_RESULT" ;
	rdfs:subClassOf in_toto_linkml:InTotoVettedPredicate ;
	skos:definition "The results of any type of test." .
<https://in-toto.io/attestation/vulns/v0.2> a owl:Class ;
	rdfs:label "VULNS" ;
	rdfs:subClassOf in_toto_linkml:InTotoVettedPredicate ;
	skos:definition "The results of a vulnerability scan of software artifacts." .
<https://slsa.dev/provenance/v1> a owl:Class ;
	rdfs:label "SLSA_PROVENANCE" ;
	rdfs:subClassOf in_toto_linkml:InTotoVettedPredicate ;
	skos:definition "How an artifact or set of artifacts was produced; lmodel/slsa models it." .
<https://slsa.dev/verification_summary/v1> a owl:Class ;
	rdfs:label "SLSA_VERIFICATION_SUMMARY" ;
	rdfs:subClassOf in_toto_linkml:InTotoVettedPredicate ;
	skos:definition "A SLSA verification decision about a software artifact; lmodel/slsa models it." .
<https://spdx.dev/Document/v2.3> a owl:Class ;
	rdfs:label "SPDX2" ;
	rdfs:subClassOf in_toto_linkml:InTotoVettedPredicate ;
	skos:definition "An SPDX 2 bill of materials for software artifacts." .
<https://spdx.dev/Document/v3> a owl:Class ;
	rdfs:label "SPDX3" ;
	rdfs:subClassOf in_toto_linkml:InTotoVettedPredicate ;
	skos:definition "An SPDX 3 bill of materials for software artifacts." .
<https://w3id.org/lmodel/in-toto.owl.ttl> dcterms:license "Apache-2.0" ;
	dcterms:source <https://github.com/in-toto/attestation/tree/v1.2.0> ;
	dcterms:title "in-toto Attestation Framework" ;
	pav:version "1.2.0" ;
	a owl:Ontology ;
	rdfs:label "in_toto_linkml" ;
	rdfs:seeAlso <https://github.com/in-toto/attestation/blob/v1.2.0/spec/README.md> , <https://in-toto.io/> , <https://lmodel.github.io/in-toto> ;
	skos:definition "A LinkML model of the in-toto Attestation Framework: the statement that binds an attestation to its subjects, the resource descriptor and digest set that identify an artifact, the predicate types the in-toto project has vetted, and the vetted predicates that no other lmodel schema models." ;
	skos:note "The version is the release of in-toto/attestation the model renders, and the specification pages and protocol buffer definitions of that release are copied to src/in_toto_linkml/schema/attestation/ at the tag and commit in the annotations. The release tags are the schema's own versions, and scripts/check_upstream_release.py reads the same pins and reports when the in-toto project releases again or the copy drifts." , "in_toto_core imports only the LinkML types, in_toto_predicates imports the core, and this file adds only the document root, so an importer can take one module. lmodel/slsa imports the core and models SLSA's own predicates." ;
	in_toto_linkml:attestation_commit "df02077bf97218a8860a5c534eff1f1381f56984" ;
	in_toto_linkml:attestation_tag "v1.2.0" .
in_toto_linkml:InTotoAdditionalDigest a owl:Class ;
	rdfs:label "InTotoAdditionalDigest" ;
	rdfs:seeAlso <https://github.com/in-toto/attestation/blob/v1.2.0/spec/v1/digest_set.md> ;
	rdfs:subClassOf _:c14n24 , _:c14n256 , _:c14n368 , _:c14n380 , _:c14n43 , _:c14n58 ;
	skos:definition "One digest under an algorithm that InTotoDigestSet does not name, such as an SCS's own revision type." ;
	skos:inScheme in_toto_linkml:in_toto_core ;
	skos:note "An SCS that does not use cryptographic digests defines a canonical revision type of its own that includes the repository, such as svn_revision_id." , "Each algorithm appears once in a list, since the attestation's JSON uses it as a key; the validator does not check this." , "In the attestation's JSON the algorithm is a key of the digest set beside the named ones, and an algorithm the framework does not define documents how its value is encoded." .
in_toto_linkml:InTotoAnnotation a owl:Class ;
	rdfs:label "InTotoAnnotation" ;
	rdfs:subClassOf _:c14n147 , _:c14n166 , _:c14n296 , _:c14n299 , _:c14n41 ;
	skos:definition "One vendor-specific annotation on a resource descriptor: a key and its values." ;
	skos:inScheme in_toto_linkml:in_toto_core ;
	skos:note "Each key appears once in a list, since the attestation's JSON uses it as a key; the validator does not check this." , "The attestation's JSON allows any JSON value. A string becomes one value and an array one value per item; any other value or item is written as its JSON text, so one value cannot tell a string from a one-item array." .
in_toto_linkml:InTotoDigestSet a owl:Class ;
	rdfs:label "InTotoDigestSet" ;
	rdfs:seeAlso <https://github.com/in-toto/attestation/blob/v1.2.0/spec/v1/digest_set.md> ;
	rdfs:subClassOf _:c14n102 , _:c14n103 , _:c14n116 , _:c14n117 , _:c14n126 , _:c14n133 , _:c14n139 , _:c14n149 , _:c14n151 , _:c14n152 , _:c14n161 , _:c14n167 , _:c14n171 , _:c14n177 , _:c14n181 , _:c14n19 , _:c14n191 , _:c14n212 , _:c14n22 , _:c14n230 , _:c14n231 , _:c14n233 , _:c14n234 , _:c14n235 , _:c14n236 , _:c14n239 , _:c14n247 , _:c14n250 , _:c14n252 , _:c14n254 , _:c14n258 , _:c14n26 , _:c14n265 , _:c14n272 , _:c14n279 , _:c14n281 , _:c14n291 , _:c14n295 , _:c14n3 , _:c14n30 , _:c14n304 , _:c14n31 , _:c14n311 , _:c14n312 , _:c14n315 , _:c14n324 , _:c14n33 , _:c14n330 , _:c14n334 , _:c14n339 , _:c14n351 , _:c14n353 , _:c14n356 , _:c14n357 , _:c14n366 , _:c14n367 , _:c14n370 , _:c14n375 , _:c14n386 , _:c14n390 , _:c14n393 , _:c14n400 , _:c14n401 , _:c14n406 , _:c14n409 , _:c14n411 , _:c14n47 , _:c14n54 , _:c14n66 , _:c14n67 , _:c14n7 , _:c14n73 , _:c14n83 , _:c14n88 , _:c14n99 ;
	skos:definition "A set of one or more digests over one artifact, keyed by algorithm, from which a consumer picks the algorithm it trusts." ;
	skos:editorialNote "Each condition in any_of names its range through a nested any_of, because the JSON Schema generator leaves a condition's own range out, and a null value would then count as present." ;
	skos:inScheme in_toto_linkml:in_toto_core ;
	skos:note "A consumer accepts only the algorithms it considers secure and ignores the rest, and two sets match when any accepted algorithm matches." , "SHAKE and BLAKE2 digests can be of any length, and this schema asks for at least 32 bytes, since a shorter digest resists collisions too weakly to identify an artifact." , "The named algorithms take lowercase hexadecimal, and additional_digests holds any other algorithm, such as an SCS's own revision type." .
in_toto_linkml:InTotoDocument a owl:Class ;
	rdfs:label "InTotoDocument" ;
	rdfs:subClassOf _:c14n165 , _:c14n261 , _:c14n55 , _:c14n71 ;
	skos:definition "A document that holds in-toto statements and the predicate types they name." ;
	skos:inScheme <https://w3id.org/lmodel/in-toto> .
in_toto_linkml:InTotoLink a owl:Class ;
	rdfs:label "InTotoLink" ;
	rdfs:seeAlso <https://github.com/in-toto/attestation/blob/v1.2.0/spec/predicates/link.md> ;
	rdfs:subClassOf in_toto_linkml:InTotoPredicate , _:c14n109 , _:c14n16 , _:c14n160 , _:c14n178 , _:c14n185 , _:c14n199 , _:c14n216 , _:c14n228 , _:c14n340 , _:c14n376 , _:c14n5 ;
	skos:definition "The predicate that records one step of an in-toto layout: the command it ran and the materials it read, for a supply chain that migrates from in-toto 0.9 links." ;
	skos:exactMatch <https://in-toto.io/attestation/link/v0.3> ;
	skos:inScheme in_toto_linkml:in_toto_predicates ;
	skos:note "The statement that carries it has predicate_type https://in-toto.io/attestation/link/v0.3." , "The statement's subjects are the step's products, and each subject's resource_name is unique within the attestation; the validator does not check this." .
in_toto_linkml:InTotoLinkMaterial a owl:Class ;
	rdfs:label "InTotoLinkMaterial" ;
	rdfs:seeAlso <https://github.com/in-toto/attestation/blob/v1.2.0/spec/predicates/link.md> ;
	rdfs:subClassOf in_toto_linkml:InTotoResourceDescriptor , _:c14n172 , _:c14n268 , _:c14n316 , _:c14n331 ;
	skos:definition "One material of a link, a resource descriptor with a name and a digest." ;
	skos:editorialNote "The name is required through a slot condition rather than slot_usage, because resource_name is an attribute of the parent class and the LinkML loader refuses slot_usage on an inherited attribute." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:InTotoMonitorLog a owl:Class ;
	rdfs:label "InTotoMonitorLog" ;
	rdfs:seeAlso <https://github.com/in-toto/attestation/blob/v1.2.0/spec/predicates/runtime-trace.md> ;
	rdfs:subClassOf _:c14n122 , _:c14n146 , _:c14n180 , _:c14n215 , _:c14n217 , _:c14n410 , _:c14n94 ;
	skos:definition "The events a runtime trace's monitor recorded: processes, network activity and file accesses, at least one of them." ;
	skos:editorialNote "Each condition in any_of names its range through a nested any_of, because the JSON Schema generator leaves a condition's own range out, and a null value would then count as present." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:InTotoMonitoredProcess a owl:Class ;
	rdfs:label "InTotoMonitoredProcess" ;
	rdfs:seeAlso <https://github.com/in-toto/attestation/blob/v1.2.0/spec/predicates/runtime-trace.md> ;
	rdfs:subClassOf _:c14n188 , _:c14n192 , _:c14n240 , _:c14n244 , _:c14n282 , _:c14n347 , _:c14n358 , _:c14n407 , _:c14n46 ;
	skos:definition "The process a runtime trace watched." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:InTotoObjectEntry a owl:Class ;
	rdfs:label "InTotoObjectEntry" ;
	rdfs:subClassOf _:c14n11 , _:c14n18 , _:c14n335 , _:c14n341 , _:c14n345 ;
	skos:definition "One key of a JSON object whose keys the framework leaves to the producer, and the key's values." ;
	skos:inScheme in_toto_linkml:in_toto_predicates ;
	skos:note "A string becomes one value and an array one value per item; any other value or item is written as its JSON text, as InTotoAnnotation does." , "Each key appears once in a list, since the attestation's JSON uses it as a key; the validator does not check this." .
in_toto_linkml:InTotoPredicate a owl:Class ;
	rdfs:label "InTotoPredicate" ;
	rdfs:seeAlso <https://github.com/in-toto/attestation/blob/v1.2.0/spec/v1/predicate.md> ;
	rdfs:subClassOf _:c14n15 , _:c14n155 , _:c14n274 , _:c14n80 ;
	skos:definition "The base of every predicate an in-toto statement can carry; predicate_kind names the concrete kind." ;
	skos:inScheme in_toto_linkml:in_toto_core ;
	skos:note "The statement's predicate_type names the predicate's type by URI, and each concrete class says which URI it renders. Nothing ties the two, since a schema that imports this module may model a predicate under its own URI." .
in_toto_linkml:InTotoPredicateType a owl:Class ;
	rdfs:label "InTotoPredicateType" ;
	rdfs:seeAlso <https://github.com/in-toto/attestation/blob/v1.2.0/spec/predicates/README.md> , <https://github.com/in-toto/attestation/blob/v1.2.0/spec/v1/predicate.md> ;
	rdfs:subClassOf _:c14n0 , _:c14n127 , _:c14n17 , _:c14n193 , _:c14n294 , _:c14n302 , _:c14n317 , _:c14n322 , _:c14n391 , _:c14n394 , _:c14n398 , _:c14n74 ;
	skos:definition "A type of predicate an in-toto statement can carry, named by the URI a statement's predicate_type holds." ;
	skos:inScheme in_toto_linkml:in_toto_predicates ;
	skos:note "Anyone can define a predicate type. The in-toto project vets some of them, and vetted_as names which vetted type this one is." , "The type URI includes the predicate's major version and changes when the predicate changes incompatibly; a minor version keeps it." .
in_toto_linkml:InTotoReference a owl:Class ;
	rdfs:label "InTotoReference" ;
	rdfs:seeAlso <https://github.com/in-toto/attestation/blob/v1.2.0/spec/predicates/reference.md> ;
	rdfs:subClassOf in_toto_linkml:InTotoPredicate , _:c14n137 , _:c14n220 , _:c14n350 , _:c14n352 , _:c14n48 ;
	skos:definition "The predicate that points from the subjects, as a whole, to documents about them, such as a bill of materials." ;
	skos:exactMatch <https://in-toto.io/attestation/reference/v0.1> ;
	skos:inScheme in_toto_linkml:in_toto_predicates ;
	skos:note "Several documents in one predicate read as if each had an attestation of its own with everything else unchanged." , "The statement that carries it has predicate_type https://in-toto.io/attestation/reference/v0.1." .
in_toto_linkml:InTotoReferenceAttester a owl:Class ;
	rdfs:label "InTotoReferenceAttester" ;
	rdfs:seeAlso <https://github.com/in-toto/attestation/blob/v1.2.0/spec/predicates/reference.md> ;
	rdfs:subClassOf _:c14n154 , _:c14n262 , _:c14n349 ;
	skos:definition "The system that provides the documents a Reference predicate points to." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:InTotoReferencedDocument a owl:Class ;
	rdfs:label "InTotoReferencedDocument" ;
	rdfs:seeAlso <https://github.com/in-toto/attestation/blob/v1.2.0/spec/predicates/reference.md> ;
	rdfs:subClassOf in_toto_linkml:InTotoResourceDescriptor , _:c14n144 , _:c14n75 ;
	skos:definition "One document a Reference predicate points to: a resource descriptor with a download location and a media type." ;
	skos:editorialNote "Both fields are required through slot conditions rather than slot_usage, because they are attributes of the parent class and the LinkML loader refuses slot_usage on an inherited attribute." ;
	skos:inScheme in_toto_linkml:in_toto_predicates ;
	skos:note "A document of unknown type takes media_type application/octet-stream." .
in_toto_linkml:InTotoRelease a owl:Class ;
	rdfs:label "InTotoRelease" ;
	rdfs:seeAlso <https://github.com/in-toto/attestation/blob/v1.2.0/spec/predicates/release.md> ;
	rdfs:subClassOf in_toto_linkml:InTotoPredicate , _:c14n173 , _:c14n245 , _:c14n246 , _:c14n342 , _:c14n36 , _:c14n377 ;
	skos:definition "The predicate that ties the subjects to one release name and version of a package, so that consumers can check what the release should contain." ;
	skos:exactMatch <https://in-toto.io/attestation/release/v0.1> ;
	skos:inScheme in_toto_linkml:in_toto_predicates ;
	skos:note "Each subject's resource_name is the artifact's file name as it would appear on disk." , "The statement that carries it has predicate_type https://in-toto.io/attestation/release/v0.1. The page is at version 0.2, which renamed releaseId to packageId, and its examples keep that URI." .
in_toto_linkml:InTotoResourceDescriptor a owl:Class ;
	rdfs:label "InTotoResourceDescriptor" ;
	rdfs:seeAlso <https://github.com/in-toto/attestation/blob/v1.2.0/spec/v1/resource_descriptor.md> ;
	rdfs:subClassOf _:c14n107 , _:c14n125 , _:c14n132 , _:c14n145 , _:c14n182 , _:c14n209 , _:c14n225 , _:c14n253 , _:c14n259 , _:c14n27 , _:c14n289 , _:c14n320 , _:c14n34 , _:c14n37 , _:c14n371 , _:c14n374 , _:c14n79 , _:c14n84 , _:c14n86 , _:c14n93 , _:c14n95 ;
	skos:definition "A reference to a software artifact or other resource by URI or digest, or the resource itself as content, with optional metadata." ;
	skos:editorialNote "Each condition in any_of names its range through a nested any_of, because the JSON Schema generator leaves a condition's own range out, and a null value would then count as present." ;
	skos:inScheme in_toto_linkml:in_toto_core ;
	skos:note "A descriptor carries at least one of a URI, a digest or its content; a field that needs a particular one says so." .
in_toto_linkml:InTotoRuntimeTrace a owl:Class ;
	rdfs:label "InTotoRuntimeTrace" ;
	rdfs:seeAlso <https://github.com/in-toto/attestation/blob/v1.2.0/spec/predicates/runtime-trace.md> ;
	rdfs:subClassOf in_toto_linkml:InTotoPredicate , _:c14n142 , _:c14n202 , _:c14n223 , _:c14n270 , _:c14n305 , _:c14n323 , _:c14n338 , _:c14n378 , _:c14n392 , _:c14n45 , _:c14n61 , _:c14n65 ;
	skos:definition "The predicate that records what a monitor traced while a supply chain step, such as a build, ran." ;
	skos:exactMatch <https://in-toto.io/attestation/runtime-trace/v0.1> ;
	skos:inScheme in_toto_linkml:in_toto_predicates ;
	skos:note "The statement that carries it has predicate_type https://in-toto.io/attestation/runtime-trace/v0.1." .
in_toto_linkml:InTotoScaiAttributeAssertion a owl:Class ;
	rdfs:label "InTotoScaiAttributeAssertion" ;
	rdfs:seeAlso <https://github.com/in-toto/attestation/blob/v1.2.0/spec/predicates/scai.md> ;
	rdfs:subClassOf _:c14n101 , _:c14n138 , _:c14n169 , _:c14n206 , _:c14n298 , _:c14n308 , _:c14n321 , _:c14n379 , _:c14n382 , _:c14n53 , _:c14n77 ;
	skos:definition "One SCAI assertion: an attribute of the subject or its producer, what it applies to, under which conditions, and the evidence for it." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:InTotoScaiAttributeReport a owl:Class ;
	rdfs:label "InTotoScaiAttributeReport" ;
	rdfs:seeAlso <https://github.com/in-toto/attestation/blob/v1.2.0/spec/predicates/scai.md> ;
	rdfs:subClassOf in_toto_linkml:InTotoPredicate , _:c14n113 , _:c14n218 , _:c14n23 , _:c14n40 , _:c14n405 ;
	skos:definition "The Software Supply Chain Attribute Integrity (SCAI) predicate: assertions about functional attributes of the subjects or their producer, each with the evidence for it." ;
	skos:exactMatch <https://in-toto.io/attestation/scai/v0.3> ;
	skos:inScheme in_toto_linkml:in_toto_predicates ;
	skos:note "The statement that carries it has predicate_type https://in-toto.io/attestation/scai/v0.3." .
in_toto_linkml:InTotoScanMetadata a owl:Class ;
	rdfs:label "InTotoScanMetadata" ;
	rdfs:seeAlso <https://github.com/in-toto/attestation/blob/v1.2.0/spec/predicates/vulns_02.md> ;
	rdfs:subClassOf _:c14n162 , _:c14n163 , _:c14n237 , _:c14n303 , _:c14n383 , _:c14n72 ;
	skos:definition "When a vulnerability scan ran." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:InTotoSimpleVerificationResult a owl:Class ;
	rdfs:label "InTotoSimpleVerificationResult" ;
	rdfs:seeAlso <https://github.com/in-toto/attestation/blob/v1.2.0/spec/predicates/svr.md> ;
	rdfs:subClassOf in_toto_linkml:InTotoPredicate , _:c14n13 , _:c14n158 , _:c14n179 , _:c14n213 , _:c14n263 , _:c14n301 , _:c14n310 , _:c14n59 ;
	skos:definition "The predicate that says a verifier evaluated the subjects against one or more policies, and which properties passed." ;
	skos:exactMatch <https://in-toto.io/attestation/svr/v0.1> ;
	skos:inScheme in_toto_linkml:in_toto_predicates ;
	skos:note "It is a lighter form of the SLSA Verification Summary, which lmodel/slsa models." , "The statement that carries it has predicate_type https://in-toto.io/attestation/svr/v0.1." .
in_toto_linkml:InTotoStatement a owl:Class ;
	rdfs:label "InTotoStatement" ;
	rdfs:seeAlso <https://github.com/in-toto/attestation/blob/v1.2.0/spec/v1/statement.md> ;
	rdfs:subClassOf _:c14n1 , _:c14n129 , _:c14n136 , _:c14n184 , _:c14n207 , _:c14n227 , _:c14n271 , _:c14n397 , _:c14n402 , _:c14n6 , _:c14n76 ;
	skos:definition "The statement layer of an in-toto attestation: the subjects it is about, the type of its predicate and the predicate itself." ;
	skos:inScheme in_toto_linkml:in_toto_core ;
	skos:note "A statement is the attestation, and its predicate is one kind of claim about the subjects, such as a test result or build provenance." , "The signature envelope around a statement, and the bundle that collects signed statements, are outside this model." .
in_toto_linkml:InTotoStatementSubject a owl:Class ;
	rdfs:label "InTotoStatementSubject" ;
	rdfs:seeAlso <https://github.com/in-toto/attestation/blob/v1.2.0/spec/v1/statement.md> ;
