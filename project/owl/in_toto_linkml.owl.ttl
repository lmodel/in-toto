in_toto_linkml:additional_digests a owl:ObjectProperty ;
	rdfs:label "additional_digests" ;
	skos:definition "The digests under algorithms this class does not name." ;
	skos:inScheme in_toto_linkml:in_toto_core .
in_toto_linkml:algorithm a owl:DatatypeProperty ;
	rdfs:label "algorithm" ;
	skos:definition "The algorithm's name, as the key the attestation's JSON uses, such as svn_revision_id." ;
	skos:inScheme in_toto_linkml:in_toto_core ;
	skos:note "An algorithm that InTotoDigestSet names, by its JSON key or by its field name, goes in that field instead." .
in_toto_linkml:annotation_key a owl:DatatypeProperty ;
	rdfs:label "annotation_key" ;
	skos:definition "The annotation's key." ;
	skos:inScheme in_toto_linkml:in_toto_core .
in_toto_linkml:annotation_values a owl:DatatypeProperty ;
	rdfs:label "annotation_values" ;
	skos:definition "The annotation's values." ;
	skos:inScheme in_toto_linkml:in_toto_core .
in_toto_linkml:annotations a owl:ObjectProperty ;
	rdfs:label "annotations" ;
	skos:definition "Vendor-specific annotations on the resource, such as the source references a SLSA Source Verification Summary records." ;
	skos:inScheme in_toto_linkml:in_toto_core .
in_toto_linkml:blake2b a owl:DatatypeProperty ;
	rdfs:label "blake2b" ;
	skos:definition "The BLAKE2b digest of the artifact, of 32 to 64 bytes." ;
	skos:inScheme in_toto_linkml:in_toto_core .
in_toto_linkml:blake2s a owl:DatatypeProperty ;
	rdfs:label "blake2s" ;
	skos:definition "The BLAKE2s digest of the artifact, at its full 32 bytes." ;
	skos:inScheme in_toto_linkml:in_toto_core .
in_toto_linkml:build_finished_on a owl:DatatypeProperty ;
	rdfs:label "build_finished_on" ;
	skos:definition "When the monitored build finished." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:build_started_on a owl:DatatypeProperty ;
	rdfs:label "build_started_on" ;
	skos:definition "When the monitored build started." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:configuration a owl:ObjectProperty ;
	rdfs:label "configuration" ;
	skos:definition "The configuration the test run used." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:content a owl:DatatypeProperty ;
	rdfs:label "content" ;
	skos:definition "The resource's content itself, base64-encoded, for a resource small enough to carry inline." ;
	skos:inScheme in_toto_linkml:in_toto_core ;
	skos:note "The in-toto framework asks for content under 1 KB, so that attestations stay small." .
in_toto_linkml:db_last_update a owl:DatatypeProperty ;
	rdfs:label "db_last_update" ;
	skos:definition "When the database was last updated." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:db_uri a owl:DatatypeProperty ;
	rdfs:label "db_uri" ;
	skos:definition "The URI that identifies the database's source." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:db_version a owl:DatatypeProperty ;
	rdfs:label "db_version" ;
	skos:definition "The database's version." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:digest a owl:ObjectProperty ;
	rdfs:label "digest" ;
	rdfs:range in_toto_linkml:InTotoDigestSet ;
	rdfs:seeAlso <https://github.com/in-toto/attestation/blob/v1.2.0/spec/v1/digest_set.md> ;
	skos:definition "The cryptographic digests of a resource's content, keyed by algorithm." ;
	skos:inScheme in_toto_linkml:in_toto_core .
in_toto_linkml:dir_hash a owl:DatatypeProperty ;
	rdfs:label "dir_hash" ;
	skos:definition "A digest over a directory's content by the dirhash Hash1 function, in lowercase hexadecimal rather than base64." ;
	skos:inScheme in_toto_linkml:in_toto_core .
in_toto_linkml:download_location a owl:DatatypeProperty ;
	rdfs:label "download_location" ;
	skos:definition "Where the resource can be fetched, when that differs from its identifying URI." ;
	skos:inScheme in_toto_linkml:in_toto_core .
in_toto_linkml:entry_key a owl:DatatypeProperty ;
	rdfs:label "entry_key" ;
	skos:definition "The object's key." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:entry_values a owl:DatatypeProperty ;
	rdfs:label "entry_values" ;
	skos:definition "The key's values." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:failed_tests a owl:DatatypeProperty ;
	rdfs:label "failed_tests" ;
	skos:definition "The names of the tests that failed." ;
	skos:inScheme in_toto_linkml:in_toto_predicates ;
	skos:note "Producer and consumer agree on what a test name means; a policy can check that test_result and failed_tests meet its requirements." .
in_toto_linkml:file_access a owl:ObjectProperty ;
	rdfs:label "file_access" ;
	skos:definition "The files the run accessed, each with its path and digests; one file may appear more than once, with different digests if it changed." ;
	skos:inScheme in_toto_linkml:in_toto_predicates ;
	skos:note "A monitor that cannot pause the build, such as one that uses eBPF, guarantees less about these digests than one that can." .
in_toto_linkml:git_blob a owl:DatatypeProperty ;
	rdfs:label "git_blob" ;
	skos:definition "The git blob id of a file's content." ;
	skos:inScheme in_toto_linkml:in_toto_core .
in_toto_linkml:git_commit a owl:DatatypeProperty ;
	rdfs:label "git_commit" ;
	skos:definition "The git commit id of a source revision." ;
	skos:inScheme in_toto_linkml:in_toto_core .
in_toto_linkml:git_tag a owl:DatatypeProperty ;
	rdfs:label "git_tag" ;
	skos:definition "The git object id of an annotated tag." ;
	skos:inScheme in_toto_linkml:in_toto_core .
in_toto_linkml:git_tree a owl:DatatypeProperty ;
	rdfs:label "git_tree" ;
	skos:definition "The git tree id of a source revision's content, or of any file tree." ;
	skos:inScheme in_toto_linkml:in_toto_core .
in_toto_linkml:gost a owl:DatatypeProperty ;
	rdfs:label "gost" ;
	skos:definition "The GOST R 34.11 digest of the artifact, of 256 or 512 bits." ;
	skos:inScheme in_toto_linkml:in_toto_core .
in_toto_linkml:host_id a owl:DatatypeProperty ;
	rdfs:label "host_id" ;
	skos:definition "The URI that identifies the host the process ran on." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:in_toto_predicate_types a owl:ObjectProperty ;
	rdfs:label "in_toto_predicate_types" ;
	skos:definition "The predicate types." ;
	skos:inScheme <https://w3id.org/lmodel/in-toto> .
in_toto_linkml:in_toto_statements a owl:ObjectProperty ;
	rdfs:label "in_toto_statements" ;
	skos:definition "The statements, each an in-toto attestation without its envelope." ;
	skos:inScheme <https://w3id.org/lmodel/in-toto> .
in_toto_linkml:materials a owl:ObjectProperty ;
	rdfs:label "materials" ;
	skos:definition "The artifacts the step read." ;
	skos:inScheme in_toto_linkml:in_toto_predicates ;
	skos:note "Each material's resource_name is unique among them; the validator does not check this." .
in_toto_linkml:md5 a owl:DatatypeProperty ;
	rdfs:label "md5" ;
	skos:definition "The MD5 digest of the artifact." ;
	skos:inScheme in_toto_linkml:in_toto_core ;
	skos:note "MD5 lacks collision resistance, so most consumers should not accept it." .
in_toto_linkml:media_type a owl:DatatypeProperty ;
	rdfs:label "media_type" ;
	skos:definition "The IANA media type of the resource's content." ;
	skos:inScheme in_toto_linkml:in_toto_core .
in_toto_linkml:monitor_config_source a owl:ObjectProperty ;
	rdfs:label "monitor_config_source" ;
	skos:definition "The monitor's configuration." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:monitor_log a owl:ObjectProperty ;
	rdfs:label "monitor_log" ;
	skos:definition "The events the monitor traced." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:monitor_type a owl:DatatypeProperty ;
	rdfs:label "monitor_type" ;
	skos:definition "The URI of the monitor's type." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:monitored_process a owl:ObjectProperty ;
	rdfs:label "monitored_process" ;
	skos:definition "The process the monitor watched." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:package_id a owl:DatatypeProperty ;
	rdfs:label "package_id" ;
	skos:definition "A stable identifier for the package that does not change between releases, so that a consumer can tell a renamed package from a reused name." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:passed_tests a owl:DatatypeProperty ;
	rdfs:label "passed_tests" ;
	skos:definition "The names of the tests that passed." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:predicate_kind a owl:DatatypeProperty ;
	rdfs:label "predicate_kind" ;
	skos:definition "The kind of predicate, one of this class's descendants." ;
	skos:inScheme in_toto_linkml:in_toto_core .
in_toto_linkml:predicate_specification a owl:DatatypeProperty ;
	rdfs:label "predicate_specification" ;
	skos:definition "The page that specifies the predicate." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:predicate_type a owl:DatatypeProperty ;
	rdfs:label "predicate_type" ;
	skos:definition "The URI that names the predicate's type and so its schema, such as https://in-toto.io/attestation/test-result/v0.1." ;
	skos:inScheme in_toto_linkml:in_toto_core .
in_toto_linkml:predicate_type_uri a owl:DatatypeProperty ;
	rdfs:label "predicate_type_uri" ;
	skos:definition "The URI that names the predicate type, such as https://in-toto.io/attestation/test-result/v0.1." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:predicate_version a owl:DatatypeProperty ;
	rdfs:label "predicate_version" ;
	skos:definition "The version of the predicate's specification, as its page states it, such as 0.1.0." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:process_event a owl:DatatypeProperty ;
	rdfs:label "process_event" ;
	skos:definition "The job or task the attestation is about." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:process_type a owl:DatatypeProperty ;
	rdfs:label "process_type" ;
	skos:definition "The URI of the type of process, such as the build type when the monitor watched a build." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:reference_attester a owl:ObjectProperty ;
	rdfs:label "reference_attester" ;
	skos:definition "The system that provides the documents." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:reference_attester_id a owl:DatatypeProperty ;
	rdfs:label "reference_attester_id" ;
	skos:definition "The URI that identifies the system." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:referenced_documents a owl:ObjectProperty ;
	rdfs:label "referenced_documents" ;
	skos:definition "The documents referred to." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:release_purl a owl:DatatypeProperty ;
	rdfs:label "release_purl" ;
	skos:definition "The package URL that names the release, with its version and, unless the package type needs them, no qualifiers or subpath." ;
	skos:inScheme in_toto_linkml:in_toto_predicates ;
	skos:note "The version follows the last @, as the purl specification parses a package URL, so a scoped npm name such as @angular/http may keep its @ unencoded, as the page's first example does." .
in_toto_linkml:resource_name a owl:DatatypeProperty ;
	rdfs:label "resource_name" ;
	skos:definition "A name for the resource within the attestation that carries it." ;
	skos:inScheme in_toto_linkml:in_toto_core .
in_toto_linkml:resource_uri a owl:DatatypeProperty ;
	rdfs:label "resource_uri" ;
	rdfs:range xsd:anyURI ;
	rdfs:seeAlso <https://github.com/in-toto/attestation/blob/v1.2.0/spec/v1/field_types.md#resourceuri> ;
	skos:definition "The URI that identifies a resource, such as a package URL, a git repository address or an OCI image reference." ;
	skos:inScheme in_toto_linkml:in_toto_core .
in_toto_linkml:ripemd160 a owl:DatatypeProperty ;
	rdfs:label "ripemd160" ;
	skos:definition "The RIPEMD-160 digest of the artifact." ;
	skos:inScheme in_toto_linkml:in_toto_core .
in_toto_linkml:scai_attribute a owl:DatatypeProperty ;
	rdfs:label "scai_attribute" ;
	skos:definition "The functional feature asserted, in a form the producer and consumer agree on." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:scai_attributes a owl:ObjectProperty ;
	rdfs:label "scai_attributes" ;
	skos:definition "One or more attribute assertions about the subjects." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:scai_conditions a owl:ObjectProperty ;
	rdfs:label "scai_conditions" ;
	skos:definition "The conditions under which the attribute arises." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:scai_evidence a owl:ObjectProperty ;
	rdfs:label "scai_evidence" ;
	skos:definition "The evidence, authenticated where possible, for the asserted attribute." ;
	skos:inScheme in_toto_linkml:in_toto_predicates ;
	skos:note "Without evidence a consumer may judge the assertion by who produced the attestation." .
in_toto_linkml:scai_producer a owl:ObjectProperty ;
	rdfs:label "scai_producer" ;
	skos:definition "The producer of the subjects, where that applies." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:scai_target a owl:ObjectProperty ;
	rdfs:label "scai_target" ;
	skos:definition "The artifact or metadata object the attribute applies to." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:scan_finished_on a owl:DatatypeProperty ;
	rdfs:label "scan_finished_on" ;
	skos:definition "When the scan finished." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:scan_metadata a owl:ObjectProperty ;
	rdfs:label "scan_metadata" ;
	skos:definition "When the scan ran." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:scan_results a owl:ObjectProperty ;
	rdfs:label "scan_results" ;
	skos:definition "The vulnerabilities the scanner found; an empty list means it found none." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:scan_started_on a owl:DatatypeProperty ;
	rdfs:label "scan_started_on" ;
	skos:definition "When the scan started." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:scanner_uri a owl:DatatypeProperty ;
	rdfs:label "scanner_uri" ;
	skos:definition "The URI that identifies the scanner's source." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:scanner_version a owl:DatatypeProperty ;
	rdfs:label "scanner_version" ;
	skos:definition "The scanner's version." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:severity_method a owl:DatatypeProperty ;
	rdfs:label "severity_method" ;
	skos:definition "The scoring method, such as nvd or cvss." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:severity_score a owl:DatatypeProperty ;
	rdfs:label "severity_score" ;
	skos:definition "The score under that method, as a string." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:sha1 a owl:DatatypeProperty ;
	rdfs:label "sha1" ;
	skos:definition "The SHA-1 digest of the artifact." ;
	skos:inScheme in_toto_linkml:in_toto_core ;
	skos:note "SHA-1 lacks collision resistance, so most consumers should not rely on it." .
in_toto_linkml:sha224 a owl:DatatypeProperty ;
	rdfs:label "sha224" ;
	skos:definition "The SHA-224 digest of the artifact." ;
	skos:inScheme in_toto_linkml:in_toto_core .
in_toto_linkml:sha256 a owl:DatatypeProperty ;
	rdfs:label "sha256" ;
	skos:definition "The SHA-256 digest of the artifact." ;
	skos:inScheme in_toto_linkml:in_toto_core .
in_toto_linkml:sha384 a owl:DatatypeProperty ;
	rdfs:label "sha384" ;
	skos:definition "The SHA-384 digest of the artifact." ;
	skos:inScheme in_toto_linkml:in_toto_core .
in_toto_linkml:sha3_224 a owl:DatatypeProperty ;
	rdfs:label "sha3_224" ;
	skos:definition "The SHA3-224 digest of the artifact." ;
	skos:inScheme in_toto_linkml:in_toto_core .
in_toto_linkml:sha3_256 a owl:DatatypeProperty ;
	rdfs:label "sha3_256" ;
	skos:definition "The SHA3-256 digest of the artifact." ;
	skos:inScheme in_toto_linkml:in_toto_core .
in_toto_linkml:sha3_384 a owl:DatatypeProperty ;
	rdfs:label "sha3_384" ;
	skos:definition "The SHA3-384 digest of the artifact." ;
	skos:inScheme in_toto_linkml:in_toto_core .
in_toto_linkml:sha3_512 a owl:DatatypeProperty ;
	rdfs:label "sha3_512" ;
	skos:definition "The SHA3-512 digest of the artifact." ;
	skos:inScheme in_toto_linkml:in_toto_core .
in_toto_linkml:sha512 a owl:DatatypeProperty ;
	rdfs:label "sha512" ;
	skos:definition "The SHA-512 digest of the artifact." ;
	skos:inScheme in_toto_linkml:in_toto_core .
in_toto_linkml:sha512_224 a owl:DatatypeProperty ;
	rdfs:label "sha512_224" ;
	skos:definition "The SHA-512/224 digest of the artifact." ;
	skos:inScheme in_toto_linkml:in_toto_core .
in_toto_linkml:sha512_256 a owl:DatatypeProperty ;
	rdfs:label "sha512_256" ;
	skos:definition "The SHA-512/256 digest of the artifact." ;
	skos:inScheme in_toto_linkml:in_toto_core .
in_toto_linkml:shake128 a owl:DatatypeProperty ;
	rdfs:label "shake128" ;
	skos:definition "The SHAKE128 digest of the artifact, of at least 32 bytes." ;
	skos:inScheme in_toto_linkml:in_toto_core .
in_toto_linkml:shake256 a owl:DatatypeProperty ;
	rdfs:label "shake256" ;
	skos:definition "The SHAKE256 digest of the artifact, of at least 32 bytes." ;
	skos:inScheme in_toto_linkml:in_toto_core .
in_toto_linkml:sm3 a owl:DatatypeProperty ;
	rdfs:label "sm3" ;
	skos:definition "The SM3 digest of the artifact." ;
	skos:inScheme in_toto_linkml:in_toto_core .
in_toto_linkml:statement_predicate a owl:ObjectProperty ;
	rdfs:label "statement_predicate" ;
	skos:definition "The predicate, one of the kinds this schema or an importing one models; predicate_kind names which. Unset means the same as empty." ;
	skos:inScheme in_toto_linkml:in_toto_core ;
	skos:note "The attestation's JSON calls this field predicate. The name here keeps it apart from LOKF's predicate, the type of a relation, which a composite schema gives one IRI." .
in_toto_linkml:statement_type a owl:DatatypeProperty ;
	rdfs:label "statement_type" ;
	skos:definition "The in-toto statement type, always https://in-toto.io/Statement/v1." ;
	skos:inScheme in_toto_linkml:in_toto_core .
in_toto_linkml:step_byproducts a owl:ObjectProperty ;
	rdfs:label "step_byproducts" ;
	skos:definition "What else the step recorded, such as its standard output, in keys the in-toto specification describes." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:step_command a owl:DatatypeProperty ;
	rdfs:label "step_command" ;
	skos:definition "The command the step ran, and its arguments; possibly empty." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:step_environment a owl:ObjectProperty ;
	rdfs:label "step_environment" ;
	skos:definition "The environment the step ran in, in keys the producer chooses." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:step_name a owl:DatatypeProperty ;
	rdfs:label "step_name" ;
	skos:definition "The name of the step, which a layout uses to find the link metadata it verifies." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:subject a owl:ObjectProperty ;
	rdfs:label "subject" ;
	skos:definition "The artifacts the predicate is about, each with a digest." ;
	skos:inScheme in_toto_linkml:in_toto_core .
in_toto_linkml:svr_verifier a owl:ObjectProperty ;
	rdfs:label "svr_verifier" ;
	skos:definition "The entity that performed the verification." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:svr_verifier_id a owl:DatatypeProperty ;
	rdfs:label "svr_verifier_id" ;
	skos:definition "The URI that identifies the verifier, versioned when its verification logic changes materially." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:test_result a owl:ObjectProperty ;
	rdfs:label "test_result" ;
	skos:definition "The result of the test run." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:test_run_url a owl:DatatypeProperty ;
	rdfs:label "test_run_url" ;
	skos:definition "Where the test run can be read, such as a CI run that holds its logs; the verifier works out how to read it." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:time_created a owl:DatatypeProperty ;
	rdfs:label "time_created" ;
	skos:definition "When the verification took place." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:trace_metadata a owl:ObjectProperty ;
	rdfs:label "trace_metadata" ;
	skos:definition "Other properties of the monitoring event." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:trace_monitor a owl:ObjectProperty ;
	rdfs:label "trace_monitor" ;
	skos:definition "The monitor instance that traced the run." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:trace_policy a owl:ObjectProperty ;
	rdfs:label "trace_policy" ;
	skos:definition "The trace policy the monitor applied, in the monitor's own format, which monitor_type names." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:traced_network a owl:DatatypeProperty ;
	rdfs:label "traced_network" ;
	skos:definition "The network activity the monitor observed, one JSON object each, written as its JSON text, in a format monitor_type determines." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:traced_processes a owl:DatatypeProperty ;
	rdfs:label "traced_processes" ;
	skos:definition "The processes the monitor observed, one JSON object each, written as its JSON text, in a format monitor_type determines." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:value a owl:DatatypeProperty ;
	rdfs:label "value" ;
	skos:definition "The digest under that algorithm, in the encoding the algorithm documents." ;
	skos:inScheme in_toto_linkml:in_toto_core .
in_toto_linkml:verified_properties a owl:DatatypeProperty ;
	rdfs:label "verified_properties" ;
	skos:definition "The properties of the subjects that passed verification, scoped to the framework or policy verified, such as SLSA_BUILD_LEVEL_3." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:vetted_as a owl:ObjectProperty ;
	rdfs:label "vetted_as" ;
	skos:definition "The vetted predicate this type is, when the in-toto project vetted it." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:vuln_annotations a owl:ObjectProperty ;
	rdfs:label "vuln_annotations" ;
	skos:definition "Custom information the scanner adds, as key and value pairs." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:vuln_db a owl:ObjectProperty ;
	rdfs:label "vuln_db" ;
	skos:definition "The vulnerability database the scanner used." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:vuln_id a owl:DatatypeProperty ;
	rdfs:label "vuln_id" ;
	skos:definition "The vulnerability's identifier, such as GHSA-fxph-q3j8-mv87 or CVE-2017-5645." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:vuln_scanner a owl:ObjectProperty ;
	rdfs:label "vuln_scanner" ;
	skos:definition "The scanner that ran, its version and the database it used." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:vuln_severity a owl:ObjectProperty ;
	rdfs:label "vuln_severity" ;
	skos:definition "The vulnerability's severity, by one or more scoring methods." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
in_toto_linkml:warned_tests a owl:DatatypeProperty ;
	rdfs:label "warned_tests" ;
	skos:definition "The names of the tests that expressed a warning." ;
	skos:inScheme in_toto_linkml:in_toto_predicates .
