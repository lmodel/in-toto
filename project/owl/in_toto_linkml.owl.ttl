	skos:inScheme in_toto_linkml:in_toto_predicates ;
	linkml:permissible_values in_toto_linkml:InTotoTestResultValue\#FAILED , in_toto_linkml:InTotoTestResultValue\#PASSED , in_toto_linkml:InTotoTestResultValue\#WARNED .
