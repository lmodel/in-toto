	linkml:slot_usage _:c14n5 ;
	linkml:slots <https://w3id.org/lmodel/in-toto/inTotoObjectEntry__entry_key> , <https://w3id.org/lmodel/in-toto/inTotoObjectEntry__entry_values> .
<https://w3id.org/lmodel/in-toto/InTotoPredicate> a linkml:ClassDefinition ;
	rdfs:seeAlso "https://github.com/in-toto/attestation/blob/v1.2.0/spec/v1/predicate.md"^^xsd:anyURI ;
	skos:altLabel "Predicate" ;
	skos:inScheme "https://w3id.org/lmodel/in-toto/in_toto_core"^^xsd:anyURI ;
	skos:note "A predicate is of one kind only, so the kinds that extend this class are mutually disjoint." , "The statement's predicate_type names the predicate's type by URI, and each concrete class says which URI it renders. Nothing ties the two, since a schema that imports this module may model a predicate under its own URI." ;
	linkml:abstract true ;
	linkml:attributes <https://w3id.org/lmodel/in-toto/predicate_kind> ;
	linkml:children_are_mutually_disjoint true ;
	linkml:class_uri "https://w3id.org/lmodel/in-toto/InTotoPredicate"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/in-toto/InTotoPredicate"^^xsd:anyURI ;
	linkml:description "The base of every predicate an in-toto statement can carry; predicate_kind names the concrete kind." ;
	linkml:slot_usage _:c14n75 ;
	linkml:slots <https://w3id.org/lmodel/in-toto/inTotoPredicate__predicate_kind> .
<https://w3id.org/lmodel/in-toto/InTotoPredicateType> a linkml:ClassDefinition ;
	rdfs:seeAlso "https://github.com/in-toto/attestation/blob/v1.2.0/spec/predicates/README.md"^^xsd:anyURI , "https://github.com/in-toto/attestation/blob/v1.2.0/spec/v1/predicate.md"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/in-toto/in_toto_predicates"^^xsd:anyURI ;
	skos:note "Anyone can define a predicate type. The in-toto project vets some of them, and vetted_as names which vetted type this one is." , "The type URI includes the predicate's major version and changes when the predicate changes incompatibly; a minor version keeps it." ;
	linkml:attributes <https://w3id.org/lmodel/in-toto/predicate_specification> , <https://w3id.org/lmodel/in-toto/predicate_type_uri> , <https://w3id.org/lmodel/in-toto/predicate_version> , <https://w3id.org/lmodel/in-toto/vetted_as> ;
