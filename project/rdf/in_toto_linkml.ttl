<https://w3id.org/lmodel/in-toto/InTotoTestResultValue> rdfs:seeAlso "https://github.com/in-toto/attestation/blob/v1.2.0/spec/predicates/test-result.md"^^xsd:anyURI , "https://www.w3.org/TR/EARL10-Schema/"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/in-toto/in_toto_predicates"^^xsd:anyURI ;
	skos:note "PASSED and FAILED mean the outcomes of the same names in W3C's Evaluation and Report Language (EARL) 1.0. EARL has no outcome for a pass with warnings, so WARNED is unmapped." , "The meanings are full addresses with no prefix bound for them, because the Python generator writes no namespace for a prefix bound only in an imported module, and shortens a full address to any prefix that covers it. The Python model holds no meaning for them; the other generators keep it." ;
	linkml:definition_uri "https://w3id.org/lmodel/in-toto/InTotoTestResultValue"^^xsd:anyURI ;
	linkml:description "The result of a test run, as a Test Result predicate records it." ;
