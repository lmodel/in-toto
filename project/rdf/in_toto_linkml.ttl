	linkml:description "When the scan finished." ;
	linkml:range <https://w3id.org/lmodel/in-toto/in_toto_timestamp> ;
	linkml:required true .
<https://w3id.org/lmodel/in-toto/scan_metadata> a linkml:SlotDefinition ;
	skos:altLabel "metadata" ;
	linkml:description "When the scan ran." ;
	linkml:inlined true ;
	linkml:range <https://w3id.org/lmodel/in-toto/InTotoScanMetadata> ;
	linkml:required true .
<https://w3id.org/lmodel/in-toto/scan_results> a linkml:SlotDefinition ;
	skos:altLabel "result" ;
	linkml:description "The vulnerabilities the scanner found; an empty list means it found none." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/in-toto/InTotoVulnResult> ;
	linkml:required true .
<https://w3id.org/lmodel/in-toto/scan_started_on> a linkml:SlotDefinition ;
	skos:altLabel "scanStartedOn" ;
	linkml:description "When the scan started." ;
	linkml:range <https://w3id.org/lmodel/in-toto/in_toto_timestamp> ;
	linkml:required true .
<https://w3id.org/lmodel/in-toto/scanner_uri> a linkml:SlotDefinition ;
	skos:altLabel "uri" ;
	linkml:description "The URI that identifies the scanner's source." ;
	linkml:range <https://w3id.org/lmodel/in-toto/in_toto_resource_uri> ;
	linkml:required true .
<https://w3id.org/lmodel/in-toto/scanner_version> a linkml:SlotDefinition ;
	skos:altLabel "version" ;
	skos:note "The page types it as a ResourceURI, and its example is a plain version, 0.19.2, so the schema takes any string." ;
	linkml:description "The scanner's version." .
<https://w3id.org/lmodel/in-toto/severity_method> a linkml:SlotDefinition ;
	skos:altLabel "method" ;
	linkml:description "The scoring method, such as nvd or cvss." ;
	linkml:required true .
<https://w3id.org/lmodel/in-toto/severity_score> a linkml:SlotDefinition ;
	skos:altLabel "score" ;
	linkml:description "The score under that method, as a string." ;
	linkml:required true .
<https://w3id.org/lmodel/in-toto/sha1> a linkml:SlotDefinition ;
	skos:note "SHA-1 lacks collision resistance, so most consumers should not rely on it." ;
	skos:relatedMatch "spdx_core:HashAlgorithm/sha1"^^xsd:anyURI ;
	linkml:any_of _:c14n57 ;
	linkml:description "The SHA-1 digest of the artifact." ;
	linkml:pattern "^[a-f0-9]{40}$" ;
	linkml:required true ;
	linkml:slot_uri "in_toto_linkml:sha1"^^xsd:anyURI .
<https://w3id.org/lmodel/in-toto/sha224> a linkml:SlotDefinition ;
	skos:relatedMatch "spdx_core:HashAlgorithm/sha224"^^xsd:anyURI ;
	linkml:any_of _:c14n84 ;
	linkml:description "The SHA-224 digest of the artifact." ;
	linkml:pattern "^[a-f0-9]{56}$" ;
	linkml:required true ;
	linkml:slot_uri "in_toto_linkml:sha224"^^xsd:anyURI .
<https://w3id.org/lmodel/in-toto/sha256> a linkml:SlotDefinition ;
	skos:relatedMatch "spdx_core:HashAlgorithm/sha256"^^xsd:anyURI ;
	linkml:any_of _:c14n60 ;
	linkml:description "The SHA-256 digest of the artifact." ;
	linkml:pattern "^[a-f0-9]{64}$" ;
	linkml:required true ;
	linkml:slot_uri "in_toto_linkml:sha256"^^xsd:anyURI .
<https://w3id.org/lmodel/in-toto/sha384> a linkml:SlotDefinition ;
	skos:relatedMatch "spdx_core:HashAlgorithm/sha384"^^xsd:anyURI ;
	linkml:any_of _:c14n42 ;
	linkml:description "The SHA-384 digest of the artifact." ;
	linkml:pattern "^[a-f0-9]{96}$" ;
	linkml:required true ;
	linkml:slot_uri "in_toto_linkml:sha384"^^xsd:anyURI .
<https://w3id.org/lmodel/in-toto/sha3_224> a linkml:SlotDefinition ;
	skos:relatedMatch "spdx_core:HashAlgorithm/sha3_224"^^xsd:anyURI ;
	linkml:any_of _:c14n98 ;
	linkml:description "The SHA3-224 digest of the artifact." ;
	linkml:pattern "^[a-f0-9]{56}$" ;
	linkml:required true ;
	linkml:slot_uri "in_toto_linkml:sha3_224"^^xsd:anyURI .
<https://w3id.org/lmodel/in-toto/sha3_256> a linkml:SlotDefinition ;
	skos:relatedMatch "spdx_core:HashAlgorithm/sha3_256"^^xsd:anyURI ;
	linkml:any_of _:c14n79 ;
	linkml:description "The SHA3-256 digest of the artifact." ;
	linkml:pattern "^[a-f0-9]{64}$" ;
	linkml:required true ;
	linkml:slot_uri "in_toto_linkml:sha3_256"^^xsd:anyURI .
<https://w3id.org/lmodel/in-toto/sha3_384> a linkml:SlotDefinition ;
	skos:relatedMatch "spdx_core:HashAlgorithm/sha3_384"^^xsd:anyURI ;
	linkml:any_of _:c14n63 ;
	linkml:description "The SHA3-384 digest of the artifact." ;
	linkml:pattern "^[a-f0-9]{96}$" ;
	linkml:required true ;
	linkml:slot_uri "in_toto_linkml:sha3_384"^^xsd:anyURI .
<https://w3id.org/lmodel/in-toto/sha3_512> a linkml:SlotDefinition ;
	skos:relatedMatch "spdx_core:HashAlgorithm/sha3_512"^^xsd:anyURI ;
	linkml:any_of _:c14n45 ;
	linkml:description "The SHA3-512 digest of the artifact." ;
	linkml:pattern "^[a-f0-9]{128}$" ;
	linkml:required true ;
	linkml:slot_uri "in_toto_linkml:sha3_512"^^xsd:anyURI .
<https://w3id.org/lmodel/in-toto/sha512> a linkml:SlotDefinition ;
	skos:relatedMatch "spdx_core:HashAlgorithm/sha512"^^xsd:anyURI ;
	linkml:any_of _:c14n85 ;
	linkml:description "The SHA-512 digest of the artifact." ;
	linkml:pattern "^[a-f0-9]{128}$" ;
	linkml:required true ;
	linkml:slot_uri "in_toto_linkml:sha512"^^xsd:anyURI .
<https://w3id.org/lmodel/in-toto/sha512_224> a linkml:SlotDefinition ;
	linkml:any_of _:c14n12 ;
	linkml:description "The SHA-512/224 digest of the artifact." ;
	linkml:pattern "^[a-f0-9]{56}$" ;
	linkml:required true ;
	linkml:slot_uri "in_toto_linkml:sha512_224"^^xsd:anyURI .
<https://w3id.org/lmodel/in-toto/sha512_256> a linkml:SlotDefinition ;
	linkml:any_of _:c14n95 ;
	linkml:description "The SHA-512/256 digest of the artifact." ;
	linkml:pattern "^[a-f0-9]{64}$" ;
	linkml:required true ;
	linkml:slot_uri "in_toto_linkml:sha512_256"^^xsd:anyURI .
<https://w3id.org/lmodel/in-toto/shake128> a linkml:SlotDefinition ;
	linkml:any_of _:c14n37 ;
	linkml:description "The SHAKE128 digest of the artifact, of at least 32 bytes." ;
	linkml:pattern "^[a-f0-9]{64}([a-f0-9]{2})*$" ;
	linkml:required true ;
	linkml:slot_uri "in_toto_linkml:shake128"^^xsd:anyURI .
<https://w3id.org/lmodel/in-toto/shake256> a linkml:SlotDefinition ;
	linkml:any_of _:c14n29 ;
	linkml:description "The SHAKE256 digest of the artifact, of at least 32 bytes." ;
	linkml:pattern "^[a-f0-9]{64}([a-f0-9]{2})*$" ;
	linkml:required true ;
	linkml:slot_uri "in_toto_linkml:shake256"^^xsd:anyURI .
<https://w3id.org/lmodel/in-toto/sm3> a linkml:SlotDefinition ;
	linkml:any_of _:c14n7 ;
	linkml:description "The SM3 digest of the artifact." ;
	linkml:pattern "^[a-f0-9]{64}$" ;
	linkml:required true ;
	linkml:slot_uri "in_toto_linkml:sm3"^^xsd:anyURI .
<https://w3id.org/lmodel/in-toto/sparqlpath> dcterms:conformsTo "https://www.w3.org/TR/sparql11-query/#propertypaths" ;
	a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"sparqlpath\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/linkml/Sparqlpath"^^xsd:anyURI ;
	linkml:description "A string encoding a SPARQL Property Path. The value of the string MUST conform to SPARQL syntax and SHOULD dereference to zero or more valid objects within the current instance document when encoded as RDF." ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/in-toto/statement_type> a linkml:SlotDefinition ;
	skos:altLabel "_type" ;
	linkml:description "The in-toto statement type, always https://in-toto.io/Statement/v1." ;
	linkml:pattern "^https://in-toto\\.io/Statement/v1$" ;
	linkml:range <https://w3id.org/lmodel/in-toto/in_toto_type_uri> ;
	linkml:required true ;
	linkml:slot_uri "in_toto_linkml:statement_type"^^xsd:anyURI .
<https://w3id.org/lmodel/in-toto/step_byproducts> a linkml:SlotDefinition ;
	skos:altLabel "byproducts" ;
	linkml:description "What else the step recorded, such as its standard output, in keys the in-toto specification describes." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/in-toto/InTotoObjectEntry> .
<https://w3id.org/lmodel/in-toto/step_command> a linkml:SlotDefinition ;
	skos:altLabel "command" ;
	linkml:description "The command the step ran, and its arguments; possibly empty." ;
	linkml:multivalued true .
<https://w3id.org/lmodel/in-toto/step_environment> a linkml:SlotDefinition ;
	skos:altLabel "environment" ;
	linkml:description "The environment the step ran in, in keys the producer chooses." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/in-toto/InTotoObjectEntry> .
<https://w3id.org/lmodel/in-toto/step_name> a linkml:SlotDefinition ;
	skos:altLabel "name" ;
	linkml:description "The name of the step, which a layout uses to find the link metadata it verifies." ;
	linkml:required true .
<https://w3id.org/lmodel/in-toto/string> a linkml:TypeDefinition ;
	skos:editorialNote "In RDF serializations, a slot with range of string is treated as a literal or type xsd:string. If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"string\"." ;
	skos:exactMatch "schema:Text"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/linkml/String"^^xsd:anyURI ;
	linkml:description "A character string" ;
	linkml:imported_from "linkml:types" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/in-toto/subject> a linkml:SlotDefinition ;
	linkml:description "The artifacts the predicate is about, each with a digest." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:minimum_cardinality 1 ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/in-toto/InTotoStatementSubject> ;
	linkml:required true ;
	linkml:slot_uri "in_toto_linkml:subject"^^xsd:anyURI .
<https://w3id.org/lmodel/in-toto/svr_verifier> a linkml:SlotDefinition ;
	skos:altLabel "verifier" ;
	linkml:description "The entity that performed the verification." ;
	linkml:inlined true ;
	linkml:range <https://w3id.org/lmodel/in-toto/InTotoSvrVerifier> ;
	linkml:required true .
<https://w3id.org/lmodel/in-toto/svr_verifier_id> a linkml:SlotDefinition ;
	skos:altLabel "id" ;
	linkml:description "The URI that identifies the verifier, versioned when its verification logic changes materially." ;
	linkml:range <https://w3id.org/lmodel/in-toto/in_toto_type_uri> ;
	linkml:required true .
<https://w3id.org/lmodel/in-toto/test_result> a linkml:SlotDefinition ;
	skos:altLabel "result" ;
	linkml:description "The result of the test run." ;
	linkml:range <https://w3id.org/lmodel/in-toto/InTotoTestResultValue> ;
	linkml:required true .
<https://w3id.org/lmodel/in-toto/test_run_url> a linkml:SlotDefinition ;
	skos:altLabel "url" ;
	linkml:description "Where the test run can be read, such as a CI run that holds its logs; the verifier works out how to read it." ;
	linkml:range <https://w3id.org/lmodel/in-toto/in_toto_resource_uri> .
<https://w3id.org/lmodel/in-toto/time> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"time\"." , "URI is dateTime because OWL reasoners do not work with straight date or time" ;
	skos:exactMatch "schema:Time"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "XSDTime" ;
	linkml:definition_uri "https://w3id.org/linkml/Time"^^xsd:anyURI ;
	linkml:description "A time object represents a (local) time of day, independent of any particular day" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#time"^^xsd:anyURI .
<https://w3id.org/lmodel/in-toto/time_created> a linkml:SlotDefinition ;
	skos:altLabel "timeCreated" ;
	linkml:description "When the verification took place." ;
	linkml:range <https://w3id.org/lmodel/in-toto/in_toto_timestamp> ;
	linkml:required true .
<https://w3id.org/lmodel/in-toto/trace_metadata> a linkml:SlotDefinition ;
	skos:altLabel "metadata" ;
	linkml:description "Other properties of the monitoring event." ;
	linkml:inlined true ;
	linkml:range <https://w3id.org/lmodel/in-toto/InTotoTraceMetadata> .
<https://w3id.org/lmodel/in-toto/trace_monitor> a linkml:SlotDefinition ;
	skos:altLabel "monitor" ;
	linkml:description "The monitor instance that traced the run." ;
	linkml:inlined true ;
	linkml:range <https://w3id.org/lmodel/in-toto/InTotoTraceMonitor> ;
	linkml:required true .
<https://w3id.org/lmodel/in-toto/trace_policy> a linkml:SlotDefinition ;
	skos:altLabel "tracePolicy" ;
	linkml:description "The trace policy the monitor applied, in the monitor's own format, which monitor_type names." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/in-toto/InTotoObjectEntry> .
<https://w3id.org/lmodel/in-toto/traced_network> a linkml:SlotDefinition ;
	skos:altLabel "network" ;
	linkml:description "The network activity the monitor observed, one JSON object each, written as its JSON text, in a format monitor_type determines." ;
	linkml:multivalued true ;
	linkml:required true .
<https://w3id.org/lmodel/in-toto/traced_processes> a linkml:SlotDefinition ;
	skos:altLabel "process" ;
	linkml:description "The processes the monitor observed, one JSON object each, written as its JSON text, in a format monitor_type determines." ;
	linkml:multivalued true ;
	linkml:required true .
<https://w3id.org/lmodel/in-toto/uri> dcterms:conformsTo "https://www.ietf.org/rfc/rfc3987.txt" ;
	a linkml:TypeDefinition ;
	skos:closeMatch "schema:URL"^^xsd:anyURI ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"uri\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	skos:note "in RDF serializations a slot with range of uri is treated as a literal or type xsd:anyURI unless it is an identifier or a reference to an identifier, in which case it is translated directly to a node" ;
	linkml:base "URI" ;
	linkml:definition_uri "https://w3id.org/linkml/Uri"^^xsd:anyURI ;
	linkml:description "a complete URI" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#anyURI"^^xsd:anyURI .
<https://w3id.org/lmodel/in-toto/uriorcurie> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"uriorcurie\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "URIorCURIE" ;
	linkml:definition_uri "https://w3id.org/linkml/Uriorcurie"^^xsd:anyURI ;
	linkml:description "a URI or a CURIE" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#anyURI"^^xsd:anyURI .
<https://w3id.org/lmodel/in-toto/value> a linkml:SlotDefinition ;
	skos:relatedMatch "spdx_core:hashValue"^^xsd:anyURI ;
	linkml:description "The digest under that algorithm, in the encoding the algorithm documents." ;
	linkml:pattern "^\\S+$" ;
	linkml:required true ;
	linkml:slot_uri "in_toto_linkml:value"^^xsd:anyURI .
<https://w3id.org/lmodel/in-toto/verified_properties> a linkml:SlotDefinition ;
	skos:altLabel "properties" ;
	linkml:description "The properties of the subjects that passed verification, scoped to the framework or policy verified, such as SLSA_BUILD_LEVEL_3." ;
	linkml:multivalued true ;
	linkml:required true .
<https://w3id.org/lmodel/in-toto/vetted_as> a linkml:SlotDefinition ;
	linkml:description "The vetted predicate this type is, when the in-toto project vetted it." ;
	linkml:range <https://w3id.org/lmodel/in-toto/InTotoVettedPredicate> .
<https://w3id.org/lmodel/in-toto/vuln_annotations> a linkml:SlotDefinition ;
	skos:altLabel "annotations" ;
	skos:note "The page calls them a list of key and value pairs, and the protocol buffer definition a list of objects. Each pair of each object is one entry, in order, so a key may appear more than once." ;
	linkml:description "Custom information the scanner adds, as key and value pairs." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/in-toto/InTotoObjectEntry> .
<https://w3id.org/lmodel/in-toto/vuln_db> a linkml:SlotDefinition ;
	skos:altLabel "db" ;
	linkml:description "The vulnerability database the scanner used." ;
	linkml:inlined true ;
	linkml:range <https://w3id.org/lmodel/in-toto/InTotoVulnDatabase> .
<https://w3id.org/lmodel/in-toto/vuln_id> a linkml:SlotDefinition ;
	skos:altLabel "id" ;
	linkml:description "The vulnerability's identifier, such as GHSA-fxph-q3j8-mv87 or CVE-2017-5645." ;
	linkml:required true .
<https://w3id.org/lmodel/in-toto/vuln_scanner> a linkml:SlotDefinition ;
	skos:altLabel "scanner" ;
	linkml:description "The scanner that ran, its version and the database it used." ;
	linkml:inlined true ;
	linkml:range <https://w3id.org/lmodel/in-toto/InTotoVulnScanner> ;
	linkml:required true .
<https://w3id.org/lmodel/in-toto/vuln_severity> a linkml:SlotDefinition ;
	skos:altLabel "severity" ;
	linkml:description "The vulnerability's severity, by one or more scoring methods." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/in-toto/InTotoVulnSeverity> ;
	linkml:required true .
<https://w3id.org/lmodel/in-toto/warned_tests> a linkml:SlotDefinition ;
	skos:altLabel "warnedTests" ;
	linkml:description "The names of the tests that expressed a warning." ;
	linkml:multivalued true .
