<https://w3id.org/lmodel/in-toto/InTotoObjectEntry> a linkml:ClassDefinition ;
	skos:closeMatch "spdx_core:DictionaryEntry"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/in-toto/in_toto_predicates"^^xsd:anyURI ;
	skos:note "A list that holds one JSON object holds each key once, since the object uses it as a key; the validator does not check this." , "A string becomes one value and an array one value per item; any other value or item is written as its JSON text, as InTotoAnnotation does." ;
