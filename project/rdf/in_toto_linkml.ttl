	linkml:uri "http://www.w3.org/ns/shex#iri"^^xsd:anyURI .
<https://w3id.org/lmodel/in-toto/package_id> a linkml:SlotDefinition ;
	skos:altLabel "packageId" ;
	linkml:description "A stable identifier for the package that does not change between releases, so that a consumer can tell a renamed package from a reused name." .
<https://w3id.org/lmodel/in-toto/passed_tests> a linkml:SlotDefinition ;
	skos:altLabel "passedTests" ;
	linkml:description "The names of the tests that passed." ;
	linkml:multivalued true .
<https://w3id.org/lmodel/in-toto/predicate> a linkml:SlotDefinition ;
	rdfs:seeAlso "https://github.com/in-toto/attestation/blob/v1.2.0/spec/v1/statement.md"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/in-toto/in_toto_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/in-toto/predicate"^^xsd:anyURI ;
	skos:note "It is a slot of its own rather than an attribute of InTotoStatement, because LOKF's predicate is a relation's type: `lokf adapt` renames a slot whose name LOKF defines, with the name of the schema it adapts as a prefix, and keeps its IRI. This repository's copy calls it in_toto_linkml_predicate, and lmodel/slsa's calls it slsa_predicate." ;
	linkml:definition_uri "https://w3id.org/lmodel/in-toto/predicate"^^xsd:anyURI ;
	linkml:description "The predicate, one of the kinds this schema or an importing one models; predicate_kind names which. Unset means the same as empty." ;
	linkml:domain_of <https://w3id.org/lmodel/in-toto/InTotoStatement> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/in-toto/InTotoStatement> ;
	linkml:range <https://w3id.org/lmodel/in-toto/InTotoPredicate> ;
	linkml:slot_uri "https://w3id.org/lmodel/in-toto/predicate"^^xsd:anyURI .
<https://w3id.org/lmodel/in-toto/predicate_kind> a linkml:SlotDefinition ;
	linkml:description "The kind of predicate, one of this class's descendants." ;
	linkml:designates_type true ;
	linkml:range <https://w3id.org/lmodel/in-toto/string> ;
	linkml:slot_uri "in_toto_linkml:predicate_kind"^^xsd:anyURI .
<https://w3id.org/lmodel/in-toto/predicate_specification> a linkml:SlotDefinition ;
	linkml:description "The page that specifies the predicate." ;
	linkml:range <https://w3id.org/lmodel/in-toto/uri> .
<https://w3id.org/lmodel/in-toto/predicate_type> a linkml:SlotDefinition ;
	skos:altLabel "predicateType" ;
	linkml:description "The URI that names the predicate's type and so its schema, such as https://in-toto.io/attestation/test-result/v0.1." ;
	linkml:range <https://w3id.org/lmodel/in-toto/in_toto_type_uri> ;
	linkml:required true ;
	linkml:slot_uri "in_toto_linkml:predicate_type"^^xsd:anyURI .
<https://w3id.org/lmodel/in-toto/predicate_type_uri> a linkml:SlotDefinition ;
	linkml:description "The URI that names the predicate type, such as https://in-toto.io/attestation/test-result/v0.1." ;
	linkml:range <https://w3id.org/lmodel/in-toto/in_toto_type_uri> ;
	linkml:required true .
<https://w3id.org/lmodel/in-toto/predicate_version> a linkml:SlotDefinition ;
	linkml:description "The version of the predicate's specification, as its page states it, such as 0.1.0." .
<https://w3id.org/lmodel/in-toto/process_event> a linkml:SlotDefinition ;
	skos:altLabel "event" ;
	linkml:description "The job or task the attestation is about." ;
	linkml:required true .
<https://w3id.org/lmodel/in-toto/process_type> a linkml:SlotDefinition ;
	skos:altLabel "type" ;
	linkml:description "The URI of the type of process, such as the build type when the monitor watched a build." ;
	linkml:range <https://w3id.org/lmodel/in-toto/in_toto_type_uri> ;
	linkml:required true .
<https://w3id.org/lmodel/in-toto/reference_attester> a linkml:SlotDefinition ;
	skos:altLabel "attester" ;
	linkml:description "The system that provides the documents." ;
	linkml:inlined true ;
	linkml:range <https://w3id.org/lmodel/in-toto/InTotoReferenceAttester> ;
	linkml:required true .
<https://w3id.org/lmodel/in-toto/reference_attester_id> a linkml:SlotDefinition ;
	skos:altLabel "id" ;
	linkml:description "The URI that identifies the system." ;
	linkml:range <https://w3id.org/lmodel/in-toto/in_toto_type_uri> ;
	linkml:required true .
<https://w3id.org/lmodel/in-toto/referenced_documents> a linkml:SlotDefinition ;
	skos:altLabel "references" ;
	linkml:description "The documents referred to." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:minimum_cardinality 1 ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/in-toto/InTotoReferencedDocument> ;
	linkml:required true .
<https://w3id.org/lmodel/in-toto/release_purl> a linkml:SlotDefinition ;
	skos:altLabel "purl" ;
	skos:closeMatch "spdx_software:packageUrl"^^xsd:anyURI ;
	skos:note "The version follows the last @, as the purl specification parses a package URL, so a scoped npm name such as @angular/http may keep its @ unencoded, as the page's first example does." ;
	linkml:description "The package URL that names the release, with its version and, unless the package type needs them, no qualifiers or subpath." ;
	linkml:pattern "^pkg:[A-Za-z][A-Za-z0-9.+-]*/[^?#]+@[^@?#]+" ;
	linkml:range <https://w3id.org/lmodel/in-toto/in_toto_resource_uri> ;
	linkml:required true .
<https://w3id.org/lmodel/in-toto/resource_name> a linkml:SlotDefinition ;
	skos:altLabel "name" ;
	linkml:any_of _:c14n49 ;
	linkml:description "A name for the resource within the attestation that carries it." ;
	linkml:required true ;
	linkml:slot_uri "in_toto_linkml:resource_name"^^xsd:anyURI .
<https://w3id.org/lmodel/in-toto/resource_uri> a linkml:SlotDefinition ;
	rdfs:seeAlso "https://github.com/in-toto/attestation/blob/v1.2.0/spec/v1/field_types.md#resourceuri"^^xsd:anyURI ;
	skos:altLabel "uri" ;
	skos:inScheme "https://w3id.org/lmodel/in-toto/in_toto_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/in-toto/resource_uri"^^xsd:anyURI ;
	linkml:any_of _:c14n58 ;
	linkml:definition_uri "https://w3id.org/lmodel/in-toto/resource_uri"^^xsd:anyURI ;
	linkml:description "The URI that identifies a resource, such as a package URL, a git repository address or an OCI image reference." ;
	linkml:domain_of <https://w3id.org/lmodel/in-toto/InTotoResourceDescriptor> ;
	linkml:owner <https://w3id.org/lmodel/in-toto/InTotoResourceDescriptor> ;
	linkml:range <https://w3id.org/lmodel/in-toto/in_toto_resource_uri> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/in-toto/resource_uri"^^xsd:anyURI .
<https://w3id.org/lmodel/in-toto/ripemd160> a linkml:SlotDefinition ;
	linkml:any_of _:c14n43 ;
	linkml:description "The RIPEMD-160 digest of the artifact." ;
	linkml:pattern "^[a-f0-9]{40}$" ;
	linkml:required true ;
	linkml:slot_uri "in_toto_linkml:ripemd160"^^xsd:anyURI .
<https://w3id.org/lmodel/in-toto/scai_attribute> a linkml:SlotDefinition ;
	skos:altLabel "attribute" ;
	linkml:description "The functional feature asserted, in a form the producer and consumer agree on." ;
	linkml:required true .
<https://w3id.org/lmodel/in-toto/scai_attributes> a linkml:SlotDefinition ;
	skos:altLabel "attributes" ;
	linkml:description "One or more attribute assertions about the subjects." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:minimum_cardinality 1 ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/in-toto/InTotoScaiAttributeAssertion> ;
	linkml:required true .
<https://w3id.org/lmodel/in-toto/scai_conditions> a linkml:SlotDefinition ;
	skos:altLabel "conditions" ;
	linkml:description "The conditions under which the attribute arises." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
