	linkml:definition_uri "https://w3id.org/lmodel/in-toto/InTotoPredicateType"^^xsd:anyURI ;
	linkml:description "A type of predicate an in-toto statement can carry, named by the URI a statement's predicate_type holds." ;
	linkml:slot_usage _:c14n1 ;
	linkml:slots <https://w3id.org/lmodel/in-toto/inTotoPredicateType__predicate_specification> , <https://w3id.org/lmodel/in-toto/inTotoPredicateType__predicate_type_uri> , <https://w3id.org/lmodel/in-toto/inTotoPredicateType__predicate_version> , <https://w3id.org/lmodel/in-toto/inTotoPredicateType__vetted_as> .
<https://w3id.org/lmodel/in-toto/InTotoReference> a linkml:ClassDefinition ;
	rdfs:seeAlso "https://github.com/in-toto/attestation/blob/v1.2.0/spec/predicates/reference.md"^^xsd:anyURI ;
	skos:altLabel "Reference" ;
	skos:exactMatch "in_toto:reference/v0.1"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/in-toto/in_toto_predicates"^^xsd:anyURI ;
	skos:note "Several documents in one predicate read as if each had an attestation of its own with everything else unchanged." , "The statement that carries it has predicate_type https://in-toto.io/attestation/reference/v0.1." ;
	linkml:attributes <https://w3id.org/lmodel/in-toto/reference_attester> , <https://w3id.org/lmodel/in-toto/referenced_documents> ;
	linkml:class_uri "https://w3id.org/lmodel/in-toto/InTotoReference"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/in-toto/InTotoReference"^^xsd:anyURI ;
	linkml:description "The predicate that points from the subjects, as a whole, to documents about them, such as a bill of materials." ;
