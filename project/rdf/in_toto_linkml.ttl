	linkml:any_of _:c14n36 ;
	linkml:definition_uri "https://w3id.org/lmodel/in-toto/digest"^^xsd:anyURI ;
	linkml:description "The cryptographic digests of a resource's content, keyed by algorithm." ;
	linkml:domain_of <https://w3id.org/lmodel/in-toto/InTotoResourceDescriptor> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:owner <https://w3id.org/lmodel/in-toto/InTotoResourceDescriptor> ;
	linkml:range <https://w3id.org/lmodel/in-toto/InTotoDigestSet> ;
