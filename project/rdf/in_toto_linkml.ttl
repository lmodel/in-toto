<https://w3id.org/lmodel/in-toto/CYCLONEDX> rdfs:seeAlso "https://cyclonedx.org/"^^xsd:anyURI , "https://github.com/in-toto/attestation/blob/v1.2.0/spec/predicates/cyclonedx.md"^^xsd:anyURI ;
	skos:note "The page gives https://cyclonedx.org/bom in its header, and this URI in its example." ;
	linkml:description "A CycloneDX bill of materials for software artifacts." ;
	linkml:meaning "https://cyclonedx.org/bom/v1.4"^^xsd:anyURI .
<https://w3id.org/lmodel/in-toto/FAILED> linkml:description "The run failed." ;
	linkml:meaning "http://www.w3.org/ns/earl#failed"^^xsd:anyURI .
<https://w3id.org/lmodel/in-toto/InTotoAdditionalDigest> a linkml:ClassDefinition ;
	rdfs:seeAlso "https://github.com/in-toto/attestation/blob/v1.2.0/spec/v1/digest_set.md"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/in-toto/in_toto_core"^^xsd:anyURI ;
	skos:note "An SCS that does not use cryptographic digests defines a canonical revision type of its own that includes the repository, such as svn_revision_id." , "Each algorithm appears once in a list, since the attestation's JSON uses it as a key; the validator does not check this." , "In the attestation's JSON the algorithm is a key of the digest set beside the named ones, and an algorithm the framework does not define documents how its value is encoded." , "It is related to, not the same as, an SPDX 3 Hash, whose algorithm comes from a closed list, where this one's may be a revision type rather than a digest." ;
	skos:relatedMatch "spdx_core:Hash"^^xsd:anyURI ;
	linkml:attributes <https://w3id.org/lmodel/in-toto/algorithm> , <https://w3id.org/lmodel/in-toto/value> ;
	linkml:class_uri "https://w3id.org/lmodel/in-toto/InTotoAdditionalDigest"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/in-toto/InTotoAdditionalDigest"^^xsd:anyURI ;
	linkml:description "One digest under an algorithm that InTotoDigestSet does not name, such as an SCS's own revision type." ;
	linkml:slot_usage _:c14n11 ;
	linkml:slots <https://w3id.org/lmodel/in-toto/inTotoAdditionalDigest__algorithm> , <https://w3id.org/lmodel/in-toto/inTotoAdditionalDigest__value> .
<https://w3id.org/lmodel/in-toto/InTotoAnnotation> a linkml:ClassDefinition ;
	skos:closeMatch "spdx_core:DictionaryEntry"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/in-toto/in_toto_core"^^xsd:anyURI ;
	skos:note "Each key appears once in a list, since the attestation's JSON uses it as a key; the validator does not check this." , "The attestation's JSON allows any JSON value. A string becomes one value and an array one value per item; any other value or item is written as its JSON text, so one value cannot tell a string from a one-item array." ;
	linkml:attributes <https://w3id.org/lmodel/in-toto/annotation_key> , <https://w3id.org/lmodel/in-toto/annotation_values> ;
	linkml:class_uri "https://w3id.org/lmodel/in-toto/InTotoAnnotation"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/in-toto/InTotoAnnotation"^^xsd:anyURI ;
	linkml:description "One vendor-specific annotation on a resource descriptor: a key and its values." ;
	linkml:slot_usage _:c14n72 ;
	linkml:slots <https://w3id.org/lmodel/in-toto/inTotoAnnotation__annotation_key> , <https://w3id.org/lmodel/in-toto/inTotoAnnotation__annotation_values> .
<https://w3id.org/lmodel/in-toto/InTotoDigestSet> a linkml:ClassDefinition ;
	rdfs:seeAlso "https://github.com/in-toto/attestation/blob/v1.2.0/spec/v1/digest_set.md"^^xsd:anyURI ;
	skos:altLabel "DigestSet" ;
	skos:editorialNote "Each condition in any_of names its range through a nested any_of, because the JSON Schema generator leaves a condition's own range out, and a null value would then count as present." ;
	skos:inScheme "https://w3id.org/lmodel/in-toto/in_toto_core"^^xsd:anyURI ;
	skos:note "A consumer accepts only the algorithms it considers secure and ignores the rest, and two sets match when any accepted algorithm matches." , "A field named after an algorithm that SPDX 3 also names relates to SPDX's individual for it. BLAKE2b relates to all three of SPDX's BLAKE2b individuals, because the framework allows any length from 32 to 64 bytes, where SPDX names only lengths of 32, 48 and 64 bytes. SPDX has no individual for the other algorithms, and an SPDX document records them as other." , "SHAKE and BLAKE2 digests can be of any length, and this schema asks for at least 32 bytes, since a shorter digest resists collisions too weakly to identify an artifact." , "The named algorithms take lowercase hexadecimal, and additional_digests holds any other algorithm, such as an SCS's own revision type." ;
	linkml:any_of _:c14n100 , _:c14n13 , _:c14n15 , _:c14n18 , _:c14n21 , _:c14n25 , _:c14n27 , _:c14n32 , _:c14n35 , _:c14n38 , _:c14n39 , _:c14n41 , _:c14n46 , _:c14n50 , _:c14n51 , _:c14n67 , _:c14n70 , _:c14n74 , _:c14n77 , _:c14n8 , _:c14n83 , _:c14n86 , _:c14n89 , _:c14n90 , _:c14n94 ;
	linkml:attributes <https://w3id.org/lmodel/in-toto/additional_digests> , <https://w3id.org/lmodel/in-toto/blake2b> , <https://w3id.org/lmodel/in-toto/blake2s> , <https://w3id.org/lmodel/in-toto/dir_hash> , <https://w3id.org/lmodel/in-toto/git_blob> , <https://w3id.org/lmodel/in-toto/git_commit> , <https://w3id.org/lmodel/in-toto/git_tag> , <https://w3id.org/lmodel/in-toto/git_tree> , <https://w3id.org/lmodel/in-toto/gost> , <https://w3id.org/lmodel/in-toto/md5> , <https://w3id.org/lmodel/in-toto/ripemd160> , <https://w3id.org/lmodel/in-toto/sha1> , <https://w3id.org/lmodel/in-toto/sha224> , <https://w3id.org/lmodel/in-toto/sha256> , <https://w3id.org/lmodel/in-toto/sha384> , <https://w3id.org/lmodel/in-toto/sha3_224> , <https://w3id.org/lmodel/in-toto/sha3_256> , <https://w3id.org/lmodel/in-toto/sha3_384> , <https://w3id.org/lmodel/in-toto/sha3_512> , <https://w3id.org/lmodel/in-toto/sha512> , <https://w3id.org/lmodel/in-toto/sha512_224> , <https://w3id.org/lmodel/in-toto/sha512_256> , <https://w3id.org/lmodel/in-toto/shake128> , <https://w3id.org/lmodel/in-toto/shake256> , <https://w3id.org/lmodel/in-toto/sm3> ;
	linkml:class_uri "https://w3id.org/lmodel/in-toto/InTotoDigestSet"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/in-toto/InTotoDigestSet"^^xsd:anyURI ;
	linkml:description "A set of one or more digests over one artifact, keyed by algorithm, from which a consumer picks the algorithm it trusts." ;
	linkml:slot_usage _:c14n78 ;
	linkml:slots <https://w3id.org/lmodel/in-toto/inTotoDigestSet__additional_digests> , <https://w3id.org/lmodel/in-toto/inTotoDigestSet__blake2b> , <https://w3id.org/lmodel/in-toto/inTotoDigestSet__blake2s> , <https://w3id.org/lmodel/in-toto/inTotoDigestSet__dir_hash> , <https://w3id.org/lmodel/in-toto/inTotoDigestSet__git_blob> , <https://w3id.org/lmodel/in-toto/inTotoDigestSet__git_commit> , <https://w3id.org/lmodel/in-toto/inTotoDigestSet__git_tag> , <https://w3id.org/lmodel/in-toto/inTotoDigestSet__git_tree> , <https://w3id.org/lmodel/in-toto/inTotoDigestSet__gost> , <https://w3id.org/lmodel/in-toto/inTotoDigestSet__md5> , <https://w3id.org/lmodel/in-toto/inTotoDigestSet__ripemd160> , <https://w3id.org/lmodel/in-toto/inTotoDigestSet__sha1> , <https://w3id.org/lmodel/in-toto/inTotoDigestSet__sha224> , <https://w3id.org/lmodel/in-toto/inTotoDigestSet__sha256> , <https://w3id.org/lmodel/in-toto/inTotoDigestSet__sha384> , <https://w3id.org/lmodel/in-toto/inTotoDigestSet__sha3_224> , <https://w3id.org/lmodel/in-toto/inTotoDigestSet__sha3_256> , <https://w3id.org/lmodel/in-toto/inTotoDigestSet__sha3_384> , <https://w3id.org/lmodel/in-toto/inTotoDigestSet__sha3_512> , <https://w3id.org/lmodel/in-toto/inTotoDigestSet__sha512> , <https://w3id.org/lmodel/in-toto/inTotoDigestSet__sha512_224> , <https://w3id.org/lmodel/in-toto/inTotoDigestSet__sha512_256> , <https://w3id.org/lmodel/in-toto/inTotoDigestSet__shake128> , <https://w3id.org/lmodel/in-toto/inTotoDigestSet__shake256> , <https://w3id.org/lmodel/in-toto/inTotoDigestSet__sm3> .
