	linkml:slot_uri "https://w3id.org/lmodel/in-toto/digest"^^xsd:anyURI .
<https://w3id.org/lmodel/in-toto/dir_hash> a linkml:SlotDefinition ;
	skos:altLabel "dirHash" ;
