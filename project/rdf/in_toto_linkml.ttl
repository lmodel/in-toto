<https://w3id.org/lmodel/in-toto/in_toto_predicate_types> a linkml:SlotDefinition ;
	linkml:description "The predicate types." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/in-toto/InTotoPredicateType> .
<https://w3id.org/lmodel/in-toto/in_toto_resource_uri> a linkml:TypeDefinition ;
	rdfs:seeAlso "https://github.com/in-toto/attestation/blob/v1.2.0/spec/v1/field_types.md#resourceuri"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/in-toto/in_toto_core"^^xsd:anyURI ;
	skos:note "The framework recommends a package URL (pkg:) or an SPDX download location (git+https:), and allows one that does not resolve." ;
	linkml:base "URI" ;
	linkml:definition_uri "https://w3id.org/lmodel/in-toto/InTotoResourceUri"^^xsd:anyURI ;
	linkml:description "A URI that identifies or locates a resource, such as a package URL or a git repository address, with its scheme and authority in lowercase." ;
	linkml:pattern "^[a-z][a-z0-9+.-]*:(//[^/?#A-Z]*([/?#].*)?|[^/].*|/[^/].*|/)?$" ;
	linkml:repr "str" ;
	linkml:typeof <https://w3id.org/lmodel/in-toto/uri> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#anyURI"^^xsd:anyURI .
<https://w3id.org/lmodel/in-toto/in_toto_statements> a linkml:SlotDefinition ;
	linkml:description "The statements, each an in-toto attestation without its envelope." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/in-toto/InTotoStatement> .
<https://w3id.org/lmodel/in-toto/in_toto_timestamp> a linkml:TypeDefinition ;
	rdfs:seeAlso "https://github.com/in-toto/attestation/blob/v1.2.0/spec/v1/field_types.md#timestamp"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/in-toto/in_toto_core"^^xsd:anyURI ;
	skos:note "It extends string rather than datetime, because the LinkML Python runtime writes a datetime's Z as +00:00, which the framework does not allow." ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/in-toto/InTotoTimestamp"^^xsd:anyURI ;
	linkml:description "A point in time in RFC 3339 format in the UTC time zone, written with a trailing Z, such as 1985-04-12T23:20:50.52Z." ;
	linkml:pattern "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$" ;
	linkml:typeof <https://w3id.org/lmodel/in-toto/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#dateTime"^^xsd:anyURI .
<https://w3id.org/lmodel/in-toto/in_toto_type_uri> a linkml:TypeDefinition ;
	rdfs:seeAlso "https://github.com/in-toto/attestation/blob/v1.2.0/spec/v1/field_types.md#typeuri"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/in-toto/in_toto_core"^^xsd:anyURI ;
	skos:note "The framework asks that it carry a version and registers none, since the namespace of a URI keeps two types apart." ;
	linkml:base "URI" ;
	linkml:definition_uri "https://w3id.org/lmodel/in-toto/InTotoTypeUri"^^xsd:anyURI ;
	linkml:description "A URI that names a type, such as a statement's or a predicate's, with its scheme and authority in lowercase." ;
	linkml:pattern "^[a-z][a-z0-9+.-]*:(//[^/?#A-Z]*([/?#].*)?|[^/].*|/[^/].*|/)?$" ;
	linkml:repr "str" ;
	linkml:typeof <https://w3id.org/lmodel/in-toto/uri> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#anyURI"^^xsd:anyURI .
<https://w3id.org/lmodel/in-toto/integer> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"integer\"." ;
	skos:exactMatch "schema:Integer"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "int" ;
	linkml:definition_uri "https://w3id.org/linkml/Integer"^^xsd:anyURI ;
	linkml:description "An integer" ;
	linkml:imported_from "linkml:types" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#integer"^^xsd:anyURI .
<https://w3id.org/lmodel/in-toto/jsonpath> dcterms:conformsTo "https://www.ietf.org/archive/id/draft-goessner-dispatch-jsonpath-00.html" ;
	a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"jsonpath\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/linkml/Jsonpath"^^xsd:anyURI ;
	linkml:description "A string encoding a JSON Path. The value of the string MUST conform to JSON Point syntax and SHOULD dereference to zero or more valid objects within the current instance document when encoded in tree form." ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/in-toto/jsonpointer> dcterms:conformsTo "https://datatracker.ietf.org/doc/html/rfc6901" ;
	a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"jsonpointer\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/linkml/Jsonpointer"^^xsd:anyURI ;
	linkml:description "A string encoding a JSON Pointer. The value of the string MUST conform to JSON Point syntax and SHOULD dereference to a valid object within the current instance document when encoded in tree form." ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/in-toto/materials> a linkml:SlotDefinition ;
	skos:note "Each material's resource_name is unique among them; the validator does not check this." ;
	linkml:description "The artifacts the step read." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/in-toto/InTotoLinkMaterial> .
<https://w3id.org/lmodel/in-toto/md5> a linkml:SlotDefinition ;
	skos:note "MD5 lacks collision resistance, so most consumers should not accept it." ;
	skos:relatedMatch "spdx_core:HashAlgorithm/md5"^^xsd:anyURI ;
	linkml:any_of _:c14n48 ;
	linkml:description "The MD5 digest of the artifact." ;
	linkml:pattern "^[a-f0-9]{32}$" ;
	linkml:required true ;
	linkml:slot_uri "in_toto_linkml:md5"^^xsd:anyURI .
<https://w3id.org/lmodel/in-toto/media_type> a linkml:SlotDefinition ;
	skos:altLabel "mediaType" ;
	skos:closeMatch "spdx_core:contentType"^^xsd:anyURI ;
	linkml:any_of _:c14n54 ;
	linkml:description "The IANA media type of the resource's content." ;
	linkml:required true ;
	linkml:slot_uri "dcat:mediaType"^^xsd:anyURI .
<https://w3id.org/lmodel/in-toto/monitor_config_source> a linkml:SlotDefinition ;
	skos:altLabel "configSource" ;
	linkml:description "The monitor's configuration." ;
	linkml:inlined true ;
	linkml:range <https://w3id.org/lmodel/in-toto/InTotoResourceDescriptor> .
<https://w3id.org/lmodel/in-toto/monitor_log> a linkml:SlotDefinition ;
	skos:altLabel "monitorLog" ;
	linkml:description "The events the monitor traced." ;
	linkml:inlined true ;
	linkml:range <https://w3id.org/lmodel/in-toto/InTotoMonitorLog> ;
	linkml:required true .
<https://w3id.org/lmodel/in-toto/monitor_type> a linkml:SlotDefinition ;
	skos:altLabel "type" ;
	linkml:description "The URI of the monitor's type." ;
	linkml:range <https://w3id.org/lmodel/in-toto/in_toto_type_uri> ;
	linkml:required true .
<https://w3id.org/lmodel/in-toto/monitored_process> a linkml:SlotDefinition ;
	skos:altLabel "monitoredProcess" ;
	linkml:description "The process the monitor watched." ;
	linkml:inlined true ;
	linkml:range <https://w3id.org/lmodel/in-toto/InTotoMonitoredProcess> ;
	linkml:required true .
<https://w3id.org/lmodel/in-toto/ncname> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"ncname\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "NCName" ;
	linkml:definition_uri "https://w3id.org/linkml/Ncname"^^xsd:anyURI ;
	linkml:description "Prefix part of CURIE" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/in-toto/nodeidentifier> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"nodeidentifier\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "NodeIdentifier" ;
	linkml:definition_uri "https://w3id.org/linkml/Nodeidentifier"^^xsd:anyURI ;
	linkml:description "A URI, CURIE or BNODE that represents a node in a model." ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/ns/shex#nonLiteral"^^xsd:anyURI .
<https://w3id.org/lmodel/in-toto/objectidentifier> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"objectidentifier\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	skos:note "Used for inheritance and type checking" ;
	linkml:base "ElementIdentifier" ;
	linkml:definition_uri "https://w3id.org/linkml/Objectidentifier"^^xsd:anyURI ;
	linkml:description "A URI or CURIE that represents an object in the model." ;
