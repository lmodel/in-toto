<https://w3id.org/lmodel/in-toto/InTotoLink> a linkml:ClassDefinition ;
	rdfs:seeAlso "https://github.com/in-toto/attestation/blob/v1.2.0/spec/predicates/link.md"^^xsd:anyURI ;
