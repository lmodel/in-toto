<https://w3id.org/lmodel/in-toto/additional_digests> a linkml:SlotDefinition ;
	linkml:description "The digests under algorithms this class does not name." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:minimum_cardinality 1 ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/in-toto/InTotoAdditionalDigest> ;
	linkml:required true ;
	linkml:slot_uri "in_toto_linkml:additional_digests"^^xsd:anyURI .
<https://w3id.org/lmodel/in-toto/algorithm> a linkml:SlotDefinition ;
	skos:note "A name starts with a lowercase letter, as the framework's own names do, so that SHA256 is not taken for sha256, and it may hold a colon, as go-witness's gitoid:sha256 does. The framework itself sets no rule for other names." , "An algorithm that InTotoDigestSet names, by its JSON key or by its field name, goes in that field instead." ;
	linkml:description "The algorithm's name, as the key the attestation's JSON uses, such as svn_revision_id." ;
	linkml:none_of _:c14n92 ;
	linkml:pattern "^[a-z][A-Za-z0-9_.:-]*$" ;
	linkml:required true ;
	linkml:slot_uri "spdx:algorithm"^^xsd:anyURI .
<https://w3id.org/lmodel/in-toto/annotation_key> a linkml:SlotDefinition ;
	skos:closeMatch "spdx_core:key"^^xsd:anyURI ;
	linkml:description "The annotation's key." ;
	linkml:required true ;
	linkml:slot_uri "in_toto_linkml:annotation_key"^^xsd:anyURI .
<https://w3id.org/lmodel/in-toto/annotation_values> a linkml:SlotDefinition ;
	skos:closeMatch "spdx_core:value"^^xsd:anyURI ;
	linkml:description "The annotation's values." ;
	linkml:multivalued true ;
	linkml:slot_uri "in_toto_linkml:annotation_values"^^xsd:anyURI .
<https://w3id.org/lmodel/in-toto/annotations> a linkml:SlotDefinition ;
	linkml:description "Vendor-specific annotations on the resource, such as the source references a SLSA Source Verification Summary records." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/in-toto/InTotoAnnotation> ;
	linkml:slot_uri "in_toto_linkml:annotations"^^xsd:anyURI .
<https://w3id.org/lmodel/in-toto/blake2b> a linkml:SlotDefinition ;
	skos:relatedMatch "spdx_core:HashAlgorithm/blake2b256"^^xsd:anyURI , "spdx_core:HashAlgorithm/blake2b384"^^xsd:anyURI , "spdx_core:HashAlgorithm/blake2b512"^^xsd:anyURI ;
	linkml:any_of _:c14n30 ;
	linkml:description "The BLAKE2b digest of the artifact, of 32 to 64 bytes." ;
	linkml:pattern "^[a-f0-9]{64}([a-f0-9]{2}){0,32}$" ;
	linkml:required true ;
	linkml:slot_uri "in_toto_linkml:blake2b"^^xsd:anyURI .
<https://w3id.org/lmodel/in-toto/blake2s> a linkml:SlotDefinition ;
	linkml:any_of _:c14n61 ;
	linkml:description "The BLAKE2s digest of the artifact, at its full 32 bytes." ;
	linkml:pattern "^[a-f0-9]{64}$" ;
	linkml:required true ;
	linkml:slot_uri "in_toto_linkml:blake2s"^^xsd:anyURI .
