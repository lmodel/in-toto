	linkml:range <https://w3id.org/lmodel/in-toto/InTotoObjectEntry> .
<https://w3id.org/lmodel/in-toto/scai_evidence> a linkml:SlotDefinition ;
	skos:altLabel "evidence" ;
	skos:note "Without evidence a consumer may judge the assertion by who produced the attestation." ;
	linkml:description "The evidence, authenticated where possible, for the asserted attribute." ;
	linkml:inlined true ;
	linkml:range <https://w3id.org/lmodel/in-toto/InTotoResourceDescriptor> .
<https://w3id.org/lmodel/in-toto/scai_producer> a linkml:SlotDefinition ;
	skos:altLabel "producer" ;
	linkml:description "The producer of the subjects, where that applies." ;
	linkml:inlined true ;
	linkml:range <https://w3id.org/lmodel/in-toto/InTotoResourceDescriptor> .
<https://w3id.org/lmodel/in-toto/scai_target> a linkml:SlotDefinition ;
	skos:altLabel "target" ;
	linkml:description "The artifact or metadata object the attribute applies to." ;
	linkml:inlined true ;
	linkml:range <https://w3id.org/lmodel/in-toto/InTotoResourceDescriptor> .
<https://w3id.org/lmodel/in-toto/scan_finished_on> a linkml:SlotDefinition ;
